{% doc %}
Shared presentation for shipping, returns and legal information pages.
{% enddoc %}

{% stylesheet %}
.shipping-page {
    background: var(--upy-canvas);
    color: var(--upy-ink);
  }

  .shipping-page__hero {
    border-bottom: 1px solid rgb(255 255 255 / 15%);
    background: #1c191a;
    color: #fff;
  }

  .shipping-page__hero-inner {
    width: min(100% - 2rem, 1440px);
    margin-inline: auto;
    padding-block: 2.5rem;
  }

  .shipping-page__eyebrow,
  .shipping-page__nav-title {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .shipping-page__eyebrow {
    color: rgb(255 255 255 / 75%);
    letter-spacing: 0.22em;
  }

  .shipping-page__title {
    margin: 1rem 0 0;
    font-size: clamp(2rem, 5.4vw, 3.75rem);
    font-weight: 300;
    font-style: italic;
    letter-spacing: -0.04em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .shipping-page__description {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    color: rgb(255 255 255 / 80%);
    font-size: 0.875rem;
    line-height: 1.9;
  }

  .shipping-page__updated {
    margin: 1.25rem 0 0;
    color: rgb(255 255 255 / 65%);
    font-size: 0.75rem;
  }

  .shipping-page__container {
    width: min(100% - 2rem, 1440px);
    margin-inline: auto;
    padding-block: 2.5rem;
  }

  .shipping-page__layout {
    display: grid;
    gap: 2.5rem;
  }

  .shipping-page__nav,
  .shipping-page__panel {
    border: 1px solid #ddd6ce;
    background: #fff;
  }

  .shipping-page__nav {
    padding: 1.25rem;
  }

  .shipping-page__nav-title {
    margin-bottom: 1rem;
    color: var(--upy-ink);
    letter-spacing: 0.12em;
  }

  .shipping-page__nav ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shipping-page__nav a {
    color: #6f6a66;
    font-size: 0.875rem;
    line-height: 1.6;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .shipping-page__nav a:hover,
  .shipping-page__nav a:focus-visible {
    color: var(--upy-accent);
  }

  .shipping-page__nav a:focus-visible,
  .shipping-page__button:focus-visible {
    outline: 2px solid var(--upy-accent);
    outline-offset: 3px;
  }

  .shipping-page__panel {
    min-width: 0;
    padding-inline: 1.25rem;
  }

  .shipping-page__summary {
    display: grid;
    gap: 1rem;
    border-bottom: 1px solid #ddd6ce;
    padding-block: 1.75rem;
  }

  .shipping-page__summary-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #5f5a55;
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .shipping-page__icon-circle {
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 2.75rem;
    place-items: center;
    border-radius: 50%;
    background: #f3f0ed;
    color: var(--upy-accent);
  }

  .shipping-page__icon-circle svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .shipping-page__section {
    scroll-margin-top: 7rem;
    border-bottom: 1px solid #ddd6ce;
    padding-block: 2rem;
  }

  .shipping-page__section:last-child {
    border-bottom: 0;
  }

  .shipping-page__section h2 {
    margin: 0;
    color: var(--upy-ink);
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    font-weight: 500;
    line-height: 1.3;
  }

  .shipping-page__copy {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
    color: #5f5a55;
    font-size: 0.875rem;
    line-height: 1.9;
  }

  .shipping-page__copy p,
  .shipping-page__card p,
  .shipping-page__note p,
  .shipping-page__contact p {
    margin: 0;
  }

  .shipping-page__copy ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.5rem;
    list-style: disc;
  }

  .shipping-page__copy li::marker {
    color: var(--upy-accent);
  }

  .shipping-page__card-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .shipping-page__card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    border: 1px solid #ddd6ce;
    padding: 1.25rem;
    background: #faf9f7;
  }

  .shipping-page__card h3 {
    margin: 0;
    color: var(--upy-ink);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .shipping-page__card p {
    margin-top: 0.5rem;
    color: #5f5a55;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .shipping-page__note {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 1.5rem;
    border: 1px solid #ddd6ce;
    padding: 1.25rem;
    background: #faf9f7;
    color: #5f5a55;
  }

  .shipping-page__note--warning {
    border-color: #ead0c3;
    background: #fff8f4;
  }

  .shipping-page__note svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 1.25rem;
    margin-top: 0.15rem;
    color: var(--upy-accent);
  }

  .shipping-page__note p {
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .shipping-page__contact {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
    border: 1px solid #ddd6ce;
    padding: 1.25rem;
    background: #faf9f7;
  }

  .shipping-page__contact-title {
    color: var(--upy-ink);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .shipping-page__contact div > p + p {
    margin-top: 0.25rem;
    color: #5f5a55;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .shipping-page__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .shipping-page__button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease;
  }

  .shipping-page__button--outline {
    border: 1px solid var(--upy-ink);
    color: var(--upy-ink);
  }

  .shipping-page__button--outline:hover {
    background: var(--upy-ink);
    color: #fff;
  }

  .shipping-page__button--accent {
    background: var(--upy-accent);
    color: #fff;
  }

  .shipping-page__button--accent:hover {
    background: #b95c34;
  }

  .shipping-page__nav .shipping-page__button--accent {
    color: #fff;
  }

  @media (min-width: 640px) {

    .shipping-page__hero-inner,
    .shipping-page__container {
      width: min(100% - 3rem, 1440px);
    }

    .shipping-page__hero-inner {
      padding-block: 4rem;
    }

    .shipping-page__container {
      padding-block: 3.5rem;
    }

    .shipping-page__panel {
      padding-inline: 2rem;
    }

    .shipping-page__summary {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .shipping-page__card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .shipping-page__card-grid--single {
      grid-template-columns: minmax(0, 1fr);
    }

    .shipping-page__actions {
      flex-direction: row;
    }

}

  @media (min-width: 1024px) {

    .shipping-page__hero-inner,
    .shipping-page__container {
      width: min(100% - 4rem, 1440px);
    }

    .shipping-page__hero-inner {
      padding-block: 6rem;
    }

    .shipping-page__container {
      padding-block: 4rem;
    }

    .shipping-page__layout {
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }

    .shipping-page__aside {
      position: sticky;
      top: 7rem;
      height: fit-content;
    }

    .shipping-page__panel {
      padding-inline: 3rem;
    }

}
{% endstylesheet %}
