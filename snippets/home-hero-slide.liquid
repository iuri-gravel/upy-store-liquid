{% doc %}
Renders one image slide for the homepage hero from the Upy Store hero metaobject.
@param {image} image - Desktop slide image
@param {image} [mobile_image] - Optional mobile-specific image
@param {collection} [collection] - Optional destination collection
@param {number} index - One-based slide position
@param {number} total - Number of available slides
@param {boolean} eager - Whether the image should load eagerly
@example
{% render 'home-hero-slide', image: image_1, mobile_image: mobile_image_1, collection: collection_1, index: 1, total: 2, eager: true %}
{% enddoc %}
{% liquid
  assign slide_alt = image.alt | default: collection.title | default: shop.name
  assign slide_label = 'home.hero.slide_count' | t: current: index, total: total
%}
<article class="home-hero__slide" data-home-hero-slide data-slide-index="{{ index | minus: 1 }}" role="group" aria-roledescription="{{ 'home.hero.slide' | t }}" aria-label="{{ slide_label }}" {% unless index == 1 %}aria-hidden="true" inert{% endunless %}>
  <picture class="home-hero__picture">
    {% if mobile_image != blank %}
      <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 1000 }}">
    {% endif %}
    {% if eager %}
      {{ image | image_url: width: 2560 | image_tag: class: 'home-hero__image', alt: slide_alt, widths: '480, 750, 1100, 1500, 2000, 2560', sizes: '100vw', loading: 'eager', decoding: 'async' }}
    {% else %}
      {{ image | image_url: width: 2560 | image_tag: class: 'home-hero__image', alt: slide_alt, widths: '480, 750, 1100, 1500, 2000, 2560', sizes: '100vw', loading: 'lazy', decoding: 'async' }}
    {% endif %}
  </picture>
  {% if collection != blank %}
    <a class="home-hero__collection-link" href="{{ collection.url }}" aria-label="{{ 'home.hero.view_collection_named' | t: title: collection.title | escape }}">{{ 'home.hero.view_collection' | t }}</a>
  {% endif %}
</article>
