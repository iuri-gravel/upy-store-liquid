<section
  class="bf-popup"
  data-black-friday-popup
  data-enabled="{{ section.settings.enabled }}"
  data-start-at="{{ section.settings.start_at | escape }}"
  data-clock-start-at="{{ section.settings.clock_start_at | escape }}"
  data-event-at="{{ section.settings.event_at | escape }}"
  data-delay-seconds="{{ section.settings.delay_seconds }}"
  data-campaign-id="bf-2026"
  data-preview="{% if request.design_mode %}true{% else %}false{% endif %}"
>
  <div class="bf-popup__clock" data-black-friday-clock aria-hidden="true" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle class="bf-popup__clock-face" cx="12" cy="12" r="9.25" />
      <path class="bf-popup__clock-hand" d="M12 12V7.3M12 12l3.6 2.1" />
      <g class="bf-popup__clock-second"><path d="M12 12V4.5" /></g>
      <circle class="bf-popup__clock-pin" cx="12" cy="12" r="1" />
    </svg>
  </div>
  <details class="bf-coupon" data-black-friday-coupon hidden>
    <summary class="bf-coupon__tab">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5A2.5 2.5 0 0 0 6.5 10h11a2.5 2.5 0 0 0 0-5h-11A2.5 2.5 0 0 0 4 7.5Zm0 9A2.5 2.5 0 0 1 6.5 14h11a2.5 2.5 0 0 1 0 5h-11A2.5 2.5 0 0 1 4 16.5ZM8 9v6m4-6v6m4-6v6" /></svg>
      <span class="bf-coupon__tab-label">{{ 'black_friday.coupon.tab' | t | escape }}</span>
    </summary>
    <div class="bf-coupon__panel" id="BlackFridayCoupon-{{ section.id }}">
      <div class="bf-coupon__header">
        <div>
          <p class="bf-coupon__eyebrow">{{ 'black_friday.coupon.eyebrow' | t | escape }}</p>
          <h2 class="bf-coupon__title">{{ 'black_friday.coupon.title' | t | escape }}</h2>
        </div>
        <button class="bf-coupon__close" type="button" data-black-friday-coupon-close aria-label="{{ 'black_friday.coupon.close' | t | escape }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
        </button>
      </div>
      <p class="bf-coupon__description">{{ 'black_friday.coupon.description' | t | escape }}</p>
      <div
        class="bf-coupon__cart-progress"
        data-black-friday-cart-progress
        data-item-count="{{ cart.item_count }}"
        data-item-one="{{ 'black_friday.coupon.cart_item_one' | t | escape }}"
        data-item-other="{{ 'black_friday.coupon.cart_item_other' | t | escape }}"
        data-stage-zero="{{ 'black_friday.coupon.stage_zero' | t | escape }}"
        data-stage-one="{{ 'black_friday.coupon.stage_one' | t | escape }}"
        data-stage-two="{{ 'black_friday.coupon.stage_two' | t | escape }}"
        data-stage-three="{{ 'black_friday.coupon.stage_three' | t | escape }}"
        data-stage-four="{{ 'black_friday.coupon.stage_four' | t | escape }}"
        data-progress-steps="{{ 'black_friday.coupon.progress_steps' | t | escape }}"
      >
        <div class="bf-coupon__progress-heading">
          <span>{{ 'black_friday.coupon.cart_progress' | t | escape }}</span>
          <strong data-black-friday-cart-count></strong>
        </div>
        <div class="bf-coupon__progress-track" data-black-friday-progress role="progressbar" aria-label="{{ 'black_friday.coupon.progress_label' | t | escape }}" aria-valuemin="0" aria-valuemax="4" aria-valuenow="0">
          <span class="bf-coupon__progress-fill" data-black-friday-progress-fill></span>
        </div>
        <p class="bf-coupon__stage-message" data-black-friday-stage-message role="status"></p>
      </div>
      <ul class="bf-coupon__tiers" aria-label="{{ 'black_friday.coupon.tiers' | t | escape }}">
        <li data-black-friday-tier="1"><span>{{ 'black_friday.coupon.one_item' | t | escape }}</span><strong>5% OFF</strong></li>
        <li data-black-friday-tier="2"><span>{{ 'black_friday.coupon.two_items' | t | escape }}</span><strong>10% OFF</strong></li>
        <li data-black-friday-tier="3"><span>{{ 'black_friday.coupon.three_items' | t | escape }}</span><strong>15% OFF</strong></li>
        <li data-black-friday-tier="4"><span>{{ 'black_friday.coupon.four_items' | t | escape }}</span><strong>20% OFF</strong></li>
      </ul>
      <p class="bf-coupon__automatic">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.2 4.2L19 7" /></svg>
        <span>{{ 'black_friday.coupon.automatic' | t | escape }}</span>
      </p>
      <a class="bf-coupon__cta" href="{{ routes.all_products_collection_url }}">{{ 'black_friday.coupon.cta' | t | escape }}</a>
    </div>
  </details>
  <dialog
    class="bf-popup__dialog"
    data-black-friday-dialog
    id="BlackFridayPopupDialog-{{ section.id }}"
    aria-labelledby="BlackFridayPopupTitle-{{ section.id }}"
    aria-describedby="BlackFridayPopupDescription-{{ section.id }}"
  >
    <div class="bf-popup__panel">
      <button class="bf-popup__close" type="button" data-black-friday-close aria-label="{{ 'header.close' | t | escape }}" autofocus>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
      <div class="bf-popup__visual{% if section.settings.image == blank %} bf-popup__visual--fallback{% endif %}">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'bf-popup__image', loading: 'lazy', alt: '', widths: '480, 720, 960, 1200', sizes: '(max-width: 680px) 100vw, 44vw' }}
          <span class="bf-popup__image-shade" aria-hidden="true"></span>
        {% endif %}
        <div
          class="bf-popup__countdown"
          data-black-friday-countdown
          data-days-before="{{ 'black_friday.countdown.days_before' | t | escape }}"
          data-day-before="{{ 'black_friday.countdown.day_before' | t | escape }}"
          data-days-label="{{ 'black_friday.countdown.days' | t | escape }}"
          data-day-label="{{ 'black_friday.countdown.day' | t | escape }}"
          data-today-label="{{ 'black_friday.countdown.today' | t | escape }}"
          data-started-label="{{ 'black_friday.countdown.started' | t | escape }}"
          data-campaign-label="{{ 'black_friday.countdown.campaign' | t | escape }}"
          role="timer"
          aria-live="off"
        >
          <span class="bf-popup__brand">UPY</span>
          <span class="bf-popup__countdown-prefix" data-black-friday-prefix>{{ 'black_friday.countdown.days_before' | t | escape }}</span>
          <span class="bf-popup__countdown-value">
            <span class="bf-popup__countdown-number" data-black-friday-number>4</span>
            <span class="bf-popup__countdown-unit" data-black-friday-unit>{{ 'black_friday.countdown.days' | t | escape }}</span>
          </span>
          <span class="bf-popup__visual-label" data-black-friday-caption>{{ 'black_friday.countdown.campaign' | t | escape }} · {{ section.settings.event_at | date: '%d/%m' }}</span>
        </div>
      </div>
      <div class="bf-popup__content">
        {% if section.settings.eyebrow != blank %}<p class="bf-popup__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 class="bf-popup__title" id="BlackFridayPopupTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <p class="bf-popup__description" id="BlackFridayPopupDescription-{{ section.id }}">{{ section.settings.body | escape }}</p>
        {% if section.settings.button_label != blank %}
          {% assign popup_button_link = section.settings.button_link | default: 'https://www.instagram.com/upystore_/' %}
          <a class="bf-popup__button" href="{{ popup_button_link | escape }}" target="_blank" rel="noopener noreferrer" data-black-friday-cta>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle class="bf-popup__instagram-dot" cx="17.5" cy="6.5" r="1" /></svg>
            <span>{{ section.settings.button_label | escape }}</span>
          </a>
        {% endif %}
      </div>
    </div>
  </dialog>
</section>

{% stylesheet %}
  .bf-popup__clock[hidden] {
    display: none;
  }

  .bf-popup__clock {
    position: fixed;
    z-index: 49;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    left: 50%;
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    transform: translateX(-50%);
    border: 1px solid rgb(255 255 255 / 24%);
    border-radius: 50%;
    background: var(--upy-accent);
    color: #fff;
    box-shadow: 0 0.25rem 0.9rem rgb(0 0 0 / 22%);
  }

  .bf-popup__clock svg {
    display: block;
    width: 1.9rem;
    height: 1.9rem;
    overflow: visible;
  }

  .bf-popup__clock-face,
  .bf-popup__clock-hand,
  .bf-popup__clock-second path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bf-popup__clock-face { stroke-width: 1.5; }
  .bf-popup__clock-hand { stroke-width: 1.7; }
  .bf-popup__clock-second path { stroke-width: 1.25; }
  .bf-popup__clock-pin { fill: currentColor; }

  .bf-coupon[hidden],
  .bf-coupon:not([open]) .bf-coupon__panel {
    display: none;
  }

  .bf-coupon {
    position: fixed;
    z-index: 48;
    top: 50%;
    right: 0;
    color: var(--upy-ink);
    font-family: inherit;
    transform: translateY(-50%);
  }

  .bf-coupon__tab {
    display: flex;
    min-height: 8.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.85rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--upy-canvas) 60%, transparent);
    border-right: 0;
    border-radius: 0.75rem 0 0 0.75rem;
    background: var(--upy-accent);
    color: #fff;
    box-shadow: 0 0.4rem 1.25rem rgb(0 0 0 / 20%);
    cursor: pointer;
    list-style: none;
  }

  .bf-coupon__tab::-webkit-details-marker { display: none; }
  .bf-coupon__tab::marker { content: ""; }

  .bf-coupon__tab svg {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .bf-coupon__tab-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .bf-coupon__panel {
    position: absolute;
    top: 50%;
    right: calc(100% + 0.65rem);
    width: min(23rem, calc(100vw - 5rem));
    max-height: calc(100dvh - 2rem);
    padding: 0 1.15rem 1.15rem;
    overflow-y: auto;
    border: 1px solid color-mix(in srgb, var(--upy-ink) 12%, transparent);
    background: var(--upy-canvas);
    box-shadow: 0 0.75rem 2.5rem rgb(0 0 0 / 22%);
    transform: translateY(-50%);
  }

  .bf-coupon__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 -1.15rem 1rem;
    padding: 1rem 1.15rem;
    background: var(--upy-ink);
    color: var(--upy-canvas);
  }

  .bf-coupon__eyebrow,
  .bf-coupon__title,
  .bf-coupon__description { margin: 0; }

  .bf-coupon__eyebrow {
    color: var(--upy-accent);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .bf-coupon__title {
    margin-top: 0.25rem;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .bf-coupon__close {
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 38%);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .bf-coupon__close svg {
    width: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.7;
  }

  .bf-coupon__description {
    margin-bottom: 0.85rem;
    color: color-mix(in srgb, var(--upy-ink) 78%, transparent);
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .bf-coupon__cart-progress {
    margin-bottom: 0.8rem;
    padding: 0.7rem;
    background: color-mix(in srgb, var(--upy-ink) 5%, var(--upy-canvas));
  }

  .bf-coupon__progress-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    font-size: 0.72rem;
  }

  .bf-coupon__progress-heading strong { font-weight: 600; }

  .bf-coupon__progress-track {
    height: 0.35rem;
    overflow: hidden;
    border-radius: 99px;
    background: color-mix(in srgb, var(--upy-ink) 14%, transparent);
  }

  .bf-coupon__progress-fill {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--upy-accent);
  }

  .bf-coupon__stage-message {
    margin: 0.5rem 0 0;
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .bf-coupon__tiers {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bf-coupon__tiers li {
    display: flex;
    min-height: 2.45rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--upy-ink) 12%, transparent);
    font-size: 0.82rem;
  }

  .bf-coupon__tiers strong {
    color: var(--upy-accent);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .bf-coupon__tiers li.is-current {
    border-color: color-mix(in srgb, var(--upy-accent) 55%, transparent);
    background: color-mix(in srgb, var(--upy-accent) 12%, var(--upy-canvas));
    font-weight: 600;
  }

  .bf-coupon__automatic {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0.9rem 0;
    color: color-mix(in srgb, var(--upy-ink) 76%, transparent);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .bf-coupon__automatic svg {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    fill: none;
    stroke: var(--upy-accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .bf-coupon__cta {
    display: flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1rem;
    background: var(--upy-accent);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
  }

  .bf-coupon__tab:focus-visible,
  .bf-coupon__close:focus-visible,
  .bf-coupon__cta:focus-visible {
    outline: 2px solid var(--upy-ink);
    outline-offset: 3px;
  }

  .bf-popup__dialog {
    width: min(52rem, calc(100% - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    overflow: auto;
    border: 0;
    background: transparent;
    color: var(--upy-ink);
  }

  .bf-popup__dialog::backdrop {
    background: rgb(16 14 14 / 72%);
    backdrop-filter: blur(3px);
  }

  .bf-popup__panel {
    position: relative;
    display: grid;
    min-height: min(34rem, calc(100dvh - 2rem));
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    overflow: hidden;
    background: var(--upy-canvas);
    box-shadow: 0 1.5rem 5rem rgb(0 0 0 / 24%);
  }

  .bf-popup__close {
    position: absolute;
    z-index: 2;
    top: 1rem;
    right: 1rem;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--upy-line);
    border-radius: 50%;
    background: var(--upy-canvas);
    color: var(--upy-ink);
    cursor: pointer;
  }

  .bf-popup__close svg {
    width: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.6;
  }

  .bf-popup__visual {
    position: relative;
    min-height: 32rem;
    overflow: hidden;
    background: var(--upy-footer);
    color: var(--upy-footer-text);
  }

  .bf-popup__visual--fallback {
    background: radial-gradient(ellipse at 50% 60%, rgb(208 107 63 / 26%), transparent 58%), var(--upy-footer);
  }

  .bf-popup__image,
  .bf-popup__image-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bf-popup__image {
    object-fit: cover;
  }

  .bf-popup__image-shade {
    background: linear-gradient(180deg, transparent 45%, rgb(14 12 12 / 36%));
  }

  .bf-popup__countdown {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 2rem;
    text-align: center;
    text-shadow: 0 1px 14px rgb(0 0 0 / 22%);
  }

  .bf-popup__brand {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .bf-popup__countdown-prefix {
    margin-top: 0.5rem;
    color: var(--upy-accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .bf-popup__countdown-value {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.55rem;
  }

  .bf-popup__countdown-number {
    font-size: clamp(4.5rem, 10vw, 7.5rem);
    font-weight: 300;
    letter-spacing: -0.09em;
    line-height: 1;
  }

  .bf-popup__countdown-unit {
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .bf-popup__visual-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.24em;
  }

  .bf-popup__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.1rem;
    padding: 4.5rem clamp(1.5rem, 4vw, 3.5rem) 3rem;
  }

  .bf-popup__eyebrow {
    margin: 0;
    color: var(--upy-accent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .bf-popup__title {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.15rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 1.08;
  }

  .bf-popup__description {
    max-width: 34ch;
    margin: 0;
    color: color-mix(in srgb, var(--upy-ink) 78%, transparent);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .bf-popup__button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    margin-top: 0.35rem;
    padding: 0.75rem 1.4rem;
    background: var(--upy-accent);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .bf-popup__button svg {
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  .bf-popup__button .bf-popup__instagram-dot {
    fill: currentColor;
    stroke: none;
  }

  .bf-popup__button:hover {
    background: color-mix(in srgb, var(--upy-accent) 82%, #000);
    transform: translateY(-1px);
  }

  .bf-popup__button:focus-visible,
  .bf-popup__close:focus-visible {
    outline: 2px solid var(--upy-ink);
    outline-offset: 3px;
  }

  @media (max-width: 680px) {
    .bf-coupon__panel {
      right: calc(100% + 0.5rem);
      width: min(22rem, calc(100vw - 4.5rem));
      padding: 0 0.9rem 0.9rem;
    }

    .bf-coupon__header {
      margin-inline: -0.9rem;
      padding-inline: 0.9rem;
    }

    .bf-coupon__tab {
      min-height: 7.5rem;
      padding-inline: 0.55rem;
    }

    .bf-popup__clock {
      bottom: calc(1rem + env(safe-area-inset-bottom));
      width: 3.25rem;
      height: 3.25rem;
    }

    .bf-popup__clock svg {
      width: 1.75rem;
      height: 1.75rem;
    }

    .bf-popup__dialog {
      width: min(32rem, calc(100% - 1rem));
      max-height: calc(100dvh - 1rem);
    }

    .bf-popup__panel {
      max-height: calc(100dvh - 1rem);
      grid-template-columns: minmax(0, 1fr);
      overflow: auto;
    }

    .bf-popup__visual {
      min-height: clamp(10rem, 34vh, 15rem);
    }

    .bf-popup__countdown {
      gap: 0.2rem;
      padding: 1rem;
    }

    .bf-popup__brand {
      font-size: 0.9rem;
    }

    .bf-popup__countdown-prefix {
      margin-top: 0.25rem;
      font-size: 0.68rem;
    }

    .bf-popup__countdown-number {
      font-size: clamp(3.6rem, 20vw, 5.2rem);
    }

    .bf-popup__countdown-unit {
      font-size: 0.75rem;
    }

    .bf-popup__visual-label {
      font-size: 0.62rem;
    }

    .bf-popup__content {
      gap: 0.8rem;
      padding: 1.7rem 1.35rem 1.5rem;
    }

    .bf-popup__title {
      max-width: 18ch;
      font-size: clamp(1.8rem, 9vw, 2.45rem);
    }

    .bf-popup__description {
      font-size: 0.9rem;
    }

    .bf-popup__button {
      width: 100%;
    }

    .bf-popup__close {
      top: 0.65rem;
      right: 0.65rem;
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .bf-coupon__progress-fill {
      transition: width 220ms ease;
    }

    .bf-coupon__panel {
      animation: bf-coupon-enter 200ms ease-out both;
    }

    .bf-popup__clock-second {
      transform-box: view-box;
      transform-origin: 12px 12px;
      animation: bf-clock-tick 60s steps(60, end) infinite;
    }

    .bf-popup__dialog[open] {
      animation: bf-popup-enter 220ms ease-out both;
    }

    @keyframes bf-clock-tick {
      to { transform: rotate(360deg); }
    }

    @keyframes bf-coupon-enter {
      from { opacity: 0; transform: translate(0.75rem, -50%); }
      to { opacity: 1; transform: translate(0, -50%); }
    }

    @keyframes bf-popup-enter {
      from { opacity: 0; transform: translateY(0.65rem) scale(0.985); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
  }
{% endstylesheet %}

