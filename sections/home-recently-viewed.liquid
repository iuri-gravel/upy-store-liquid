<section
  class="home-recent"
  data-recently-viewed
  data-product-limit="{{ section.settings.product_limit }}"
  aria-labelledby="home-recently-title-{{ section.id }}"
  hidden
>
  <div class="home-recent__container">
    <header class="home-recent__heading">
      <svg class="home-recent__clock" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 7v5l3 2"></path>
      </svg>
      <h2 class="home-recent__title" id="home-recently-title-{{ section.id }}">
        {{ section.settings.title | escape }}
      </h2>
    </header>

    <div class="home-recent__grid" data-recently-viewed-grid role="list" aria-label="{{ section.settings.title | escape }}"></div>
    <p class="visually-hidden" data-recently-viewed-status aria-live="polite"></p>
  </div>
</section>


{% stylesheet %}
.home-recent[hidden] {
  display: none;
}

.home-recent {
  padding: 2rem 0 4rem;
  background: var(--upy-canvas);
  color: var(--upy-ink);
}

.home-recent__container {
  width: calc(100% - 2rem);
  max-width: 86rem;
  margin-inline: auto;
}

.home-recent__heading {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1.25rem;
}

.home-recent__clock {
  width: 1rem;
  height: 1rem;
  flex: 0 0 1rem;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.7;
}

.home-recent__title {
  margin: 0;
  font-family: var(--upy-font-body);
  font-size: 1rem;
  font-weight: 500;
  letter-spacing: -0.015em;
  line-height: 1.4;
}

.home-recent__grid {
  display: flex;
  gap: 0.75rem;
  overflow-x: auto;
  padding-bottom: 0.5rem;
  overscroll-behavior-x: contain;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.home-recent__grid::-webkit-scrollbar {
  display: none;
}

.home-recent__card {
  min-width: 0;
  width: 72vw;
  max-width: 18.75rem;
  flex: 0 0 auto;
  scroll-snap-align: start;
}

.home-recent__image-link {
  display: block;
  color: inherit;
  text-decoration: none;
}

.home-recent__image-wrap {
  overflow: hidden;
  aspect-ratio: 4 / 5;
  background: #ece9e5;
}

.home-recent__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 500ms ease;
}

.home-recent__card:hover .home-recent__image {
  transform: scale(1.015);
}

.home-recent__details {
  padding: 0.5rem 0.125rem 0.75rem;
}

.home-recent__swatches {
  display: flex;
  flex-wrap: wrap;
  min-width: 0;
  min-height: 2rem;
  align-items: center;
  gap: 0.2rem;
  margin-bottom: 0.55rem;
}

.home-recent__swatch {
  display: grid;
  width: 2rem;
  height: 2rem;
  flex: 0 0 2rem;
  padding: 0;
  place-items: center;
  border: 1px solid transparent;
  border-radius: 50%;
  background: transparent;
  cursor: pointer;
}

.home-recent__swatch:focus-visible {
  outline: 1px solid var(--upy-ink);
  outline-offset: 2px;
}

.home-recent__swatch-dot {
  display: block;
  width: 1.75rem;
  height: 1.75rem;
  border: 1px solid rgb(0 0 0 / 10%);
  border-radius: 50%;
  transition: transform 180ms ease;
}

.home-recent__swatch.is-selected .home-recent__swatch-dot {
  transform: scale(1.1);
}

.home-recent__swatch:hover:not(.is-selected) .home-recent__swatch-dot {
  box-shadow: 0 0 0 1px #aaa49f;
}

.home-recent__product-link {
  display: block;
  color: inherit;
  text-decoration: none;
}

.home-recent__product-title {
  overflow: hidden;
  margin: 0;
  color: var(--upy-ink);
  font-family: var(--upy-font-body);
  font-size: 0.9rem;
  font-weight: 300;
  letter-spacing: -0.01em;
  line-height: 1.45;
  text-overflow: ellipsis;
}

.home-recent__color-label {
  overflow: hidden;
  margin: 0.1rem 0 0;
  color: #77716c;
  font-size: 0.75rem;
  font-weight: 300;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-recent__color-label[hidden] {
  display: none;
}

.home-recent__price {
  margin: 0.65rem 0 0;
  color: var(--upy-ink);
  font-size: 0.88rem;
  font-weight: 500;
  letter-spacing: -0.01em;
}

.home-recent__pix {
  margin: 0.25rem 0 0;
  color: #75803f;
  font-size: 0.68rem;
  font-weight: 300;
}

.home-recent__product-link:focus-visible,
.home-recent__image-link:focus-visible {
  outline: 2px solid var(--upy-ink);
  outline-offset: 3px;
}

@media (min-width: 640px) {
  .home-recent__container {
    width: calc(100% - 3rem);
  }

  .home-recent__card {
    width: 48vw;
  }

}

@media (min-width: 1024px) {
  .home-recent {
    padding-block: 2rem 4.5rem;
  }

  .home-recent__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    overflow: visible;
    padding-bottom: 0;
  }

  .home-recent__card {
    width: auto;
    max-width: none;
  }

}

@media (prefers-reduced-motion: reduce) {
  .home-recent__image,
  .home-recent__swatch-dot {
    transition: none;
  }

}
{% endstylesheet %}

{% schema %}
{
  "name": "Vistos recentemente",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Vistos Recentemente"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Quantidade de produtos",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Vistos recentemente"
    }
  ]
}
{% endschema %}
