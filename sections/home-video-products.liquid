{% assign video_section = metaobjects.videoproductssection.videoproductssection %}
{% assign video_item_count = 0 %}

{% liquid
  assign instagram_url = blank
  assign instagram_parts = video_section.video_teste.value | strip | split: '?' | first | split: '#' | first | split: '/'
  assign instagram_host = instagram_parts[2] | downcase
  assign instagram_type = instagram_parts[3]
  assign instagram_id = instagram_parts[4]
  assign instagram_id_encoded = instagram_id | url_encode
  if instagram_parts[0] == 'https:' and instagram_parts[1] == '' and instagram_parts.size == 5 and instagram_id != blank and instagram_id == instagram_id_encoded
    if instagram_host == 'www.instagram.com' or instagram_host == 'instagram.com'
      if instagram_type == 'p' or instagram_type == 'reel'
        unless instagram_id contains '.'
          assign instagram_url = 'https://www.instagram.com/' | append: instagram_type | append: '/' | append: instagram_id | append: '/'
          assign video_item_count = 1
        endunless
      endif
    endif
  endif
%}

{% if video_section != blank %}
  {% for item_index in (1..8) %}
    {% assign video_field_key = 'video_' | append: item_index %}
    {% assign product_field_key = 'produto_' | append: item_index %}
    {% assign video_field = video_section[video_field_key] %}
    {% assign product_field = video_section[product_field_key] %}
    {% assign video = video_field.value %}
    {% assign product_item = product_field.value %}

    {% if video != blank and product_item != blank %}
      {% if video.sources.size > 0 %}
        {% assign video_item_count = video_item_count | plus: 1 %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if video_item_count > 0 %}
  <section class="home-video-products" aria-label="{{ section.settings.title | default: 'Visto na Upy' | escape }}" data-home-video-section>
    <header class="home-video-products__heading">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="home-video-products__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 class="home-video-products__title">{{ section.settings.title | default: 'Visto na Upy' | escape }}</h2>
      </div>
      {% if section.settings.supporting_text != blank %}<p class="home-video-products__supporting-text">{{ section.settings.supporting_text | escape }}</p>{% endif %}
    </header>

    <div class="home-video-products__carousel" data-home-video-carousel data-center-if-fits="{% if video_item_count <= 4 %}true{% else %}false{% endif %}">
      <div class="home-video-products__track" data-home-video-track data-item-count="{{ video_item_count }}" role="group" aria-label="Vídeos de produtos" aria-roledescription="carrossel">
        {% for item_index in (1..8) %}
          {% assign video_field_key = 'video_' | append: item_index %}
          {% assign product_field_key = 'produto_' | append: item_index %}
          {% assign video_field = video_section[video_field_key] %}
          {% assign product_field = video_section[product_field_key] %}
          {% assign video = video_field.value %}
          {% assign product_item = product_field.value %}

          {% if video != blank and product_item != blank %}
            {% if video.sources.size > 0 %}
              <div class="home-video-products__slide">
                {% render 'home-video-product-card', video: video, product_item: product_item %}
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if instagram_url != blank %}
          <div class="home-video-products__slide">
            <a class="home-video-products__card home-video-products__instagram-card" href="{{ instagram_url | escape }}" data-home-video-card data-home-instagram-open aria-label="{{ 'home.instagram.play' | t | escape }}">
              <span class="home-video-products__play" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M8 5.8c0-.7.8-1.1 1.4-.7l10 6.2a.8.8 0 0 1 0 1.4l-10 6.2c-.6.4-1.4 0-1.4-.7V5.8Z" /></svg>
              </span>
              <span class="home-video-products__instagram-label">Instagram</span>
            </a>
          </div>
        {% endif %}
      </div>

      {% if video_item_count > 1 %}
        <div class="home-video-products__controls" aria-label="Controles dos vídeos">
          <button class="home-video-products__arrow" type="button" data-home-video-previous aria-label="Ver vídeos anteriores" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
          </button>
          <button class="home-video-products__arrow" type="button" data-home-video-next aria-label="Ver próximos vídeos">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </button>
        </div>
      {% endif %}
      {% if instagram_url != blank %}
        <dialog class="home-video-products__instagram-dialog" data-home-instagram-dialog aria-label="{{ 'home.instagram.video' | t | escape }}">
          <form class="home-video-products__instagram-controls" method="dialog">
            <a href="{{ instagram_url | escape }}" target="_blank" rel="noopener">{{ 'home.instagram.open' | t }}</a>
            <button type="submit" autofocus>{{ 'header.close' | t }}</button>
          </form>
          <div data-home-instagram-frame></div>
          <template data-home-instagram-player>
            <iframe src="{{ instagram_url | append: 'embed/' | escape }}" title="{{ 'home.instagram.video' | t | escape }}" allow="fullscreen; encrypted-media; picture-in-picture" allowfullscreen></iframe>
          </template>
        </dialog>
      {% endif %}
    </div>
    <p class="visually-hidden" data-home-video-status aria-live="polite"></p>
  </section>
{% endif %}


{% stylesheet %}
.home-video-products {
  overflow: hidden;
  padding-block: 3rem 3.75rem;
  background: var(--upy-canvas);
  color: var(--upy-ink);
}

.home-video-products__heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem;
  margin-inline: clamp(1.25rem, 2.5vw, 3rem);
}

.home-video-products__eyebrow {
  margin: 0 0 0.35rem;
  color: var(--upy-ink);
  font-family: var(--upy-font-heading);
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

.home-video-products__title {
  margin: 0;
  color: var(--upy-ink);
  font-family: var(--upy-font-heading);
  font-size: clamp(2.25rem, 3.3vw, 3.25rem);
  font-weight: 300;
  letter-spacing: -0.055em;
  line-height: 1.08;
}

.home-video-products__supporting-text {
  flex: 0 0 auto;
  margin: 0 0 0.25rem;
  color: var(--upy-ink);
  font-family: var(--upy-font-heading);
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.home-video-products__carousel {
  position: relative;
  margin-top: 2.75rem;
}

.home-video-products__track {
  display: flex;
  gap: 0.75rem;
  overflow-x: auto;
  overscroll-behavior-x: contain;
  padding-inline: 1.25rem;
  scrollbar-width: none;
  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
}

.home-video-products__track::-webkit-scrollbar {
  display: none;
}

.home-video-products__track.is-centered {
  justify-content: center;
}

.home-video-products__slide {
  min-width: 0;
  flex: 0 0 74%;
  scroll-snap-align: start;
}

.home-video-products__card {
  position: relative;
  display: block;
  overflow: hidden;
  aspect-ratio: 9 / 16;
  border-radius: 1.35rem;
  background: var(--upy-ink);
  box-shadow: 0 14px 32px rgb(28 25 26 / 12%);
  color: #fff;
  isolation: isolate;
}

.home-video-products__card:focus-visible {
  outline: 2px solid var(--upy-ink);
  outline-offset: 4px;
}

.home-video-products__instagram-card {
  background: linear-gradient(155deg, #534845, var(--upy-ink) 75%);
}

.home-video-products__instagram-label {
  position: absolute;
  right: 1rem;
  bottom: 1rem;
  left: 1rem;
  text-align: center;
  font-weight: 500;
}

.home-video-products__instagram-dialog {
  width: min(26.25rem, calc(100% - 1rem));
  max-height: calc(100dvh - 1rem);
  margin: auto;
  padding: 0;
  border: 0;
  border-radius: 0.75rem;
  background: var(--upy-canvas);
  color: var(--upy-ink);
}

.home-video-products__instagram-dialog::backdrop {
  background: rgb(0 0 0 / 70%);
}

.home-video-products__instagram-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  padding-inline: 0.75rem;
}

.home-video-products__instagram-controls a,
.home-video-products__instagram-controls button {
  display: inline-flex;
  min-height: 2.75rem;
  align-items: center;
  color: inherit;
}

.home-video-products__instagram-controls a {
  text-decoration: underline;
}

.home-video-products__instagram-controls button {
  padding-inline: 0.5rem;
  border: 0;
  background: transparent;
  cursor: pointer;
}

.home-video-products__instagram-dialog iframe {
  display: block;
  width: 100%;
  height: min(46rem, calc(100dvh - 3.75rem));
  border: 0;
  background: #fff;
}

.home-video-products__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 700ms ease;
}

.home-video-products__card:hover .home-video-products__video {
  transform: scale(1.03);
}

.home-video-products__gradient {
  position: absolute;
  z-index: 1;
  inset: 0;
  background: linear-gradient(180deg, rgb(0 0 0 / 5%) 0%, transparent 44%, rgb(0 0 0 / 55%) 100%);
  pointer-events: none;
}

.home-video-products__play {
  position: absolute;
  z-index: 2;
  top: 50%;
  left: 50%;
  display: grid;
  width: 2.75rem;
  height: 2.75rem;
  transform: translate(-50%, -50%);
  place-items: center;
  border-radius: 50%;
  background: rgb(0 0 0 / 28%);
  backdrop-filter: blur(2px);
  color: #fff;
  pointer-events: none;
  transition: transform 300ms ease;
}

.home-video-products__card:hover .home-video-products__play {
  transform: translate(-50%, -50%) scale(1.1);
}

.home-video-products__play svg {
  width: 1.25rem;
  height: 1.25rem;
  fill: currentColor;
}

.home-video-products__product {
  position: absolute;
  z-index: 2;
  right: 0.75rem;
  bottom: 0.75rem;
  left: 0.75rem;
  display: flex;
  min-height: 4.1rem;
  align-items: center;
  gap: 0.65rem;
  border: 1px solid rgb(255 255 255 / 20%);
  border-radius: 0.7rem;
  padding: 0.5rem 0.6rem;
  background: rgb(28 25 26 / 74%);
  box-shadow: 0 0.4rem 1.1rem rgb(0 0 0 / 18%);
  backdrop-filter: blur(12px);
  color: #fff;
}

.home-video-products__product-image {
  display: block;
  width: 2.75rem;
  height: 2.75rem;
  flex: 0 0 2.75rem;
  overflow: hidden;
  border-radius: 0.4rem;
  background: var(--upy-canvas);
}

.home-video-products__product-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.home-video-products__product-info {
  display: block;
  min-width: 0;
}

.home-video-products__product-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  font-family: var(--upy-font-body);
  font-size: 0.7rem;
  font-weight: 600;
  line-height: 1.2;
}

.home-video-products__price {
  display: block;
  margin-top: 0.25rem;
  font-family: var(--upy-font-body);
  font-size: 0.86rem;
  font-weight: 600;
  line-height: 1.1;
}

.home-video-products__controls {
  position: absolute;
  z-index: 3;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: space-between;
  padding-inline: 0.75rem;
  pointer-events: none;
}

.home-video-products__carousel.has-overflow .home-video-products__controls {
  display: flex;
}

.home-video-products__arrow {
  display: grid;
  width: 2.75rem;
  height: 2.75rem;
  padding: 0;
  place-items: center;
  border: 0;
  border-radius: 50%;
  background: rgb(28 25 26 / 55%);
  box-shadow: 0 0.35rem 1rem rgb(0 0 0 / 18%);
  backdrop-filter: blur(4px);
  color: #fff;
  cursor: pointer;
  pointer-events: auto;
  transition: background-color 180ms ease, transform 180ms ease;
}

.home-video-products__arrow:hover:not(:disabled) {
  transform: scale(1.06);
  background: rgb(28 25 26 / 75%);
}

.home-video-products__arrow:disabled {
  visibility: hidden;
}

.home-video-products__arrow:focus-visible {
  outline: 2px solid #fff;
  outline-offset: 3px;
}

.home-video-products__arrow svg {
  width: 1.3rem;
  height: 1.3rem;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.8;
}

@media (min-width: 640px) {
  .home-video-products__track {
    gap: 1rem;
    padding-inline: 2rem;
  }

  .home-video-products__slide {
    flex-basis: calc((100% - 1rem) / 2);
  }

  .home-video-products__supporting-text {
    display: block;
  }

  .home-video-products__controls {
    padding-inline: 1rem;
  }

  .home-video-products__product {
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    gap: 0.75rem;
    padding: 0.6rem 0.65rem;
  }

}

@media (max-width: 639px) {
  .home-video-products__supporting-text {
    display: none;
  }

}

@media (min-width: 1024px) {
  .home-video-products {
    padding-block: 3rem 3.75rem;
  }

  .home-video-products__heading {
    margin-inline: clamp(2rem, 2.5vw, 3rem);
  }

  .home-video-products__carousel {
    margin-top: 2.9rem;
  }

  .home-video-products__track {
    gap: 1.25rem;
    padding-inline: clamp(2rem, 2.5vw, 3rem);
  }

  .home-video-products__slide {
    flex-basis: 21rem;
  }

  .home-video-products__product {
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    min-height: 4.1rem;
    padding: 0.55rem 0.65rem;
  }

  .home-video-products__controls {
    padding-inline: clamp(1rem, 2vw, 2rem);
  }

}
{% endstylesheet %}

{% schema %}
{
  "name": "Visto na Upy",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto de apoio",
      "default": "Movimento real"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Visto na Upy"
    },
    {
      "type": "text",
      "id": "supporting_text",
      "label": "Texto à direita",
      "default": "Use em movimento"
    }
  ],
  "presets": [
    {
      "name": "Visto na Upy"
    }
  ]
}
{% endschema %}
