{% liquid
  assign requested_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign selected_variant = requested_variant
  assign color_option_index = -1
  assign size_option_index = -1
  assign breadcrumb_collection = product.collections.first
  assign chart_kind = section.settings.size_chart
  assign composition_field = product.metafields.custom.composition
  assign composition = composition_field.value
  assign technologies = product.metafields.custom.technologies.value
  assign pinned_video = product.media | where: 'media_type', 'video' | first
  if pinned_video == blank
    assign pinned_video = product.media | where: 'media_type', 'external_video' | first
  endif
  assign gallery_media_count = product.media.size
  if pinned_video != blank
    assign gallery_media_count = gallery_media_count | minus: 1
  endif
  assign gallery_media_index = 0
  assign product_form_id = 'ProductForm-' | append: section.id

  for option in product.options_with_values
    assign normalized_option_name = option.name | downcase
    if normalized_option_name == 'cor' or normalized_option_name == 'color' or normalized_option_name == 'colour'
      assign color_option_index = forloop.index0
    elsif normalized_option_name == 'tamanho' or normalized_option_name == 'size'
      assign size_option_index = forloop.index0
    endif
  endfor

  assign selected_variant = blank
  assign first_purchasable_variant = blank
  for variant in product.variants
    assign variant_is_image_only = false
    if size_option_index >= 0
      assign variant_size_value = variant.options[size_option_index] | downcase | strip
      if variant_size_value == 'img 1' or variant_size_value == 'img 2'
        assign variant_is_image_only = true
      endif
    endif
    unless variant_is_image_only
      if variant.id == requested_variant.id
        assign selected_variant = variant
        break
      endif
      if first_purchasable_variant == blank and variant.available
        assign first_purchasable_variant = variant
      endif
    endunless
  endfor
  if selected_variant == blank
    assign selected_variant = first_purchasable_variant
  endif
  if selected_variant == blank
    assign selected_variant = product.variants.first
  endif

  if chart_kind == 'auto'
    assign product_title_normalized = product.title | downcase
    if product_title_normalized contains 'short' or product_title_normalized contains 'calça' or product_title_normalized contains 'calca' or product_title_normalized contains 'legging'
      assign chart_kind = 'bottoms'
    else
      assign chart_kind = 'tops'
    endif
  endif
%}

<section
  class="main-product"
  data-product-page
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle | escape }}"
  data-product-url="{{ product.url }}"
  data-product-title="{{ product.title | escape }}"
  data-color-option-index="{{ color_option_index }}"
  data-size-option-index="{{ size_option_index }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-chart-kind="{{ chart_kind }}"
  data-msg-add="{{ 'product.add_to_cart' | t | escape }}"
  data-msg-unavailable="{{ 'product.unavailable' | t | escape }}"
  data-msg-select-size="{{ 'product.select_size' | t | escape }}"
  data-msg-select-options="{{ 'product.select_options' | t | escape }}"
  data-msg-adding="{{ 'product.adding' | t | escape }}"
  data-msg-variant-unavailable="{{ 'product.variant_unavailable' | t | escape }}"
  data-msg-add-error="{{ 'product.add_error' | t | escape }}"
>
  <nav class="main-product__breadcrumbs" aria-label="{{ 'product.breadcrumb' | t | escape }}">
    <a href="{{ routes.root_url }}">{{ 'collection.home' | t }}</a>
    <span aria-hidden="true">›</span>
    {% if breadcrumb_collection != blank %}
      <a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title | escape }}</a>
      <span aria-hidden="true">›</span>
    {% endif %}
    <span aria-current="page">{{ product.title | escape }}</span>
  </nav>

  <div class="main-product__layout">
    <div class="main-product__gallery" data-product-gallery aria-label="{{ 'product.gallery' | t: title: product.title | escape }}">
      {% if gallery_media_count > 0 %}
        <div class="main-product__media-stage">
          <div class="main-product__media-grid" data-media-grid>
          {% for media in product.media %}
            {% assign is_pinned_video = false %}
            {% if pinned_video != blank and media.id == pinned_video.id %}{% assign is_pinned_video = true %}{% endif %}
            {% unless is_pinned_video %}
              {% assign media_loading = 'lazy' %}
              {% if gallery_media_index == 0 %}{% assign media_loading = 'eager' %}{% endif %}
              <figure
                class="main-product__media{% if gallery_media_index == 0 %} is-active{% endif %}"
                data-product-media
                data-media-index="{{ forloop.index0 }}"
                data-media-id="{{ media.id }}"
                data-media-type="{{ media.media_type }}"
                data-media-default="{% if media.id == product.featured_media.id %}true{% else %}false{% endif %}"
                {% if gallery_media_index > 0 %}hidden{% endif %}
              >
                {% case media.media_type %}
                  {% when 'image' %}
                    {{ media | image_url: width: 1800 | image_tag: widths: '480, 720, 960, 1200, 1600, 1800', sizes: '(min-width: 1000px) 32vw, 100vw', loading: media_loading, alt: media.alt | default: product.title | escape }}
                  {% when 'video' %}
                    {{ media | media_tag: controls: true, preload: 'none', image_size: '1200x' }}
                  {% when 'external_video' %}
                    {{ media | external_video_tag }}
                  {% when 'model' %}
                    {{ media | media_tag: image_size: '1200x' }}
                  {% else %}
                    {{ media.preview_image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 1000px) 32vw, 100vw', loading: 'lazy', alt: media.alt | default: product.title | escape }}
                {% endcase %}
                <button class="main-product__zoom" type="button" data-open-lightbox aria-label="{{ 'product.enlarge_image' | t: number: forloop.index, title: product.title | escape }}">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5M10.8 7.5v6.6M7.5 10.8h6.6"></path></svg>
                </button>
              </figure>
              {% assign gallery_media_index = gallery_media_index | plus: 1 %}
            {% endunless %}
          {% endfor %}
          </div>
          {% if gallery_media_count > 1 %}
            <button class="main-product__gallery-arrow main-product__gallery-arrow--previous" type="button" data-gallery-previous aria-label="{{ 'product.previous_image' | t | escape }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5.5-6.5 6.5 6.5 6.5" /></svg>
            </button>
            <button class="main-product__gallery-arrow main-product__gallery-arrow--next" type="button" data-gallery-next aria-label="{{ 'product.next_image' | t | escape }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5.5 6.5 6.5-6.5 6.5" /></svg>
            </button>
          {% endif %}
        </div>
        {% if gallery_media_count > 1 %}
          <div class="main-product__gallery-controls">
            <div class="main-product__gallery-dots" data-gallery-dots aria-label="{{ 'product.choose_image' | t | escape }}">
              {% assign gallery_dot_index = 0 %}
              {% for media in product.media %}
                {% unless pinned_video != blank and media.id == pinned_video.id %}
                  <button type="button" data-gallery-dot data-media-index="{{ forloop.index0 }}" aria-label="{{ 'product.view_image' | t: number: forloop.index | escape }}"{% if gallery_dot_index == 0 %} aria-current="true"{% endif %}></button>
                  {% assign gallery_dot_index = gallery_dot_index | plus: 1 %}
                {% endunless %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% else %}
        <div class="main-product__media main-product__media--placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'main-product__placeholder' }}
        </div>
      {% endif %}
    </div>

    {% if pinned_video != blank %}
      <button class="main-product__video-backdrop" type="button" data-video-backdrop aria-label="Fechar vídeo ampliado" hidden></button>
      <div class="main-product__video-bubble" data-product-floating-video role="button" tabindex="0" aria-label="Ampliar vídeo do produto" aria-expanded="false">
        {% if pinned_video.media_type == 'video' %}
          {{ pinned_video | media_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '480x' }}
        {% elsif pinned_video.host == 'youtube' %}
          {{ pinned_video | external_video_url: autoplay: '1', controls: '0', loop: '1', mute: '1', playlist: pinned_video.external_id, playsinline: '1' | external_video_tag }}
        {% else %}
          {{ pinned_video | external_video_url: autoplay: '1', controls: '0', loop: '1', muted: '1', playsinline: '1' | external_video_tag }}
        {% endif %}
      </div>
    {% endif %}

    <div class="main-product__details">
      <div class="main-product__details-inner">
        <div class="main-product__title-row">
          <h1 class="main-product__title">{{ product.title | escape }}</h1>
        </div>

        {% form 'product', product, id: product_form_id, class: 'main-product__form' %}
          <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id>
          <input type="hidden" name="quantity" value="1" data-quantity-input>
          <script type="application/json" data-product-variants>
            [
              {% for variant in product.variants %}
                {% unless forloop.first %},{% endunless %}
                {"id":{{ variant.id | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"compareAtPrice":{{ variant.compare_at_price | json }},"inventoryQuantity":{{ variant.inventory_quantity | json }},"inventoryManagement":{{ variant.inventory_management | json }},"inventoryPolicy":{{ variant.inventory_policy | json }},"featuredMediaId":{{ variant.featured_media.id | json }}}
              {% endfor %}
            ]
          </script>

          <div class="main-product__price-block" aria-live="polite">
            {% if selected_variant.compare_at_price > selected_variant.price %}
              <s class="main-product__compare-price" data-compare-price>{{ selected_variant.compare_at_price | money }}</s>
            {% else %}
              <s class="main-product__compare-price" data-compare-price hidden></s>
            {% endif %}
            <p class="main-product__price" data-product-price>{{ selected_variant.price | money }}</p>
            <p class="main-product__pix"><span data-pix-price>{{ selected_variant.price | times: 0.95 | round | money }}</span> {{ 'product.pix_suffix' | t }}</p>
            <p class="main-product__installments">{{ 'product.installments_prefix' | t }} <span data-installment-price>{{ selected_variant.price | divided_by: 3.0 | round | money }}</span> {{ 'product.installments_suffix' | t }}</p>
          </div>

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              {% assign option_index = forloop.index0 %}
              {% assign option_kind = 'other' %}
              {% if option_index == color_option_index %}{% assign option_kind = 'color' %}{% endif %}
              {% if option_index == size_option_index %}{% assign option_kind = 'size' %}{% endif %}
              <fieldset class="main-product__option main-product__option--{{ option_kind }}" data-product-option data-option-index="{{ option_index }}" data-option-kind="{{ option_kind }}">
                <legend>
                  {% if option_kind == 'color' %}{{ 'product.color' | t }}: <span data-selected-option-label>{{ selected_variant.options[option_index] | default: option.values.first.name | default: option.values.first | escape }}</span>
                  {% elsif option_kind == 'size' %}{{ option.name | escape }}: <span data-selected-option-label></span>
                  {% else %}{{ option.name | escape }}{% endif %}
                </legend>
                {% if option_kind == 'color' %}
                  <div class="main-product__swatches" role="group" aria-label="{{ 'product.available_colors' | t | escape }}">
                    {% for option_value in option.values %}
                      {% assign color_value = option_value.name | default: option_value %}
                      {% assign color_key = color_value | handleize %}
                      {% assign color_variant_image = blank %}
                      {% for color_variant in product.variants %}
                        {% if color_variant.options[color_option_index] == color_value and color_variant.featured_media.preview_image != blank %}
                          {% assign color_variant_image = color_variant.featured_media.preview_image %}
                          {% break %}
                        {% endif %}
                      {% endfor %}
                      <button type="button" class="main-product__swatch" data-option-button data-option-value="{{ color_value | escape }}" data-color-key="{{ color_key }}" aria-label="{{ 'product.select_color' | t: color: color_value | escape }}" aria-pressed="false" title="{{ color_value | escape }}">
                        <span aria-hidden="true">
                          {% if color_variant_image != blank %}
                            {{ color_variant_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '2.75rem', alt: '' }}
                          {% endif %}
                        </span>
                      </button>
                    {% endfor %}
                  </div>
                {% elsif option_kind == 'size' %}
                  <div class="main-product__sizes" role="group" aria-label="{{ 'product.available_sizes' | t | escape }}">
                    {% for option_value in option.values %}
                      {% assign size_value = option_value.name | default: option_value %}
                      {% assign normalized_size_value = size_value | downcase | strip %}
                      {% unless normalized_size_value == 'img 1' or normalized_size_value == 'img 2' %}<button type="button" class="main-product__size" data-option-button data-option-value="{{ size_value | escape }}" aria-pressed="false">{{ size_value | escape }}</button>{% endunless %}
                    {% endfor %}
                  </div>
                {% else %}
                  <select class="main-product__select" data-option-select aria-label="{{ option.name | escape }}">
                    {% for option_value in option.values %}
                      {% assign other_value = option_value.name | default: option_value %}
                      <option value="{{ other_value | escape }}"{% if selected_variant.options[option_index] == other_value %} selected{% endif %}>{{ other_value | escape }}</option>
                    {% endfor %}
                  </select>
                {% endif %}
              </fieldset>
            {% endfor %}
          {% endunless %}

          <div class="main-product__size-tools"{% if size_option_index < 0 %} hidden{% endif %}>
            <button class="main-product__size-tool" type="button" data-sizebay-open>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18.5 12 13l9 5.5v2H3zM12 13V5m0 0L8.5 8.5M12 5l3.5 3.5"></path></svg>
              {{ 'product.discover_size' | t }}
            </button>
            <button class="main-product__size-tool" type="button" data-size-chart-open>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18v10H3zM7 7v3m4-3v2m4-2v3m4-3v2"></path></svg>
              {{ 'product.size_chart' | t }}
            </button>
          </div>
          <div id="sizebay-container" class="main-product__sizebay" data-sizebay-route="{{ canonical_url | escape }}" data-product-sizebay></div>

          <div class="main-product__quantity-wrap">
            <label for="ProductQuantity-{{ section.id }}">{{ 'product.quantity' | t }}</label>
            <div class="main-product__quantity" data-product-quantity>
              <button type="button" data-quantity-decrease aria-label="{{ 'product.decrease_quantity' | t | escape }}">−</button>
              <input id="ProductQuantity-{{ section.id }}" type="number" value="1" min="1" inputmode="numeric" aria-label="{{ 'product.quantity' | t | escape }}" data-quantity-value>
              <button type="button" data-quantity-increase aria-label="{{ 'product.increase_quantity' | t | escape }}">+</button>
            </div>
          </div>

          <p class="main-product__selection-error" data-selection-error role="alert" hidden>{{ 'product.selection_error' | t }}</p>
          <p class="main-product__cart-feedback" data-cart-feedback role="status" aria-live="polite"></p>
          <div class="main-product__actions" data-product-actions>
            <button class="main-product__add" type="submit" name="add" data-add-to-cart{% if product.available == false %} disabled{% endif %}>
              {% if product.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'product.unavailable' | t }}{% endif %}
            </button>
            <button class="main-product__buy" type="button" data-buy-now hidden{% if product.available == false %} disabled{% endif %}>{{ 'product.buy_now' | t }}</button>
            <button
              class="main-product__favorite"
              type="button"
              data-product-wishlist
              data-product-id="{{ product.id }}"
              data-product-title="{{ product.title | escape }}"
              data-product-handle="{{ product.handle | escape }}"
              data-product-url="{{ product.url }}"
              data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 240 }}{% endif %}"
              data-label-favorite="{{ 'product.favorite_add' | t: title: product.title | escape }}"
              data-label-unfavorite="{{ 'product.favorite_remove' | t: title: product.title | escape }}"
              data-label-favorite-text="{{ 'product.favorite_button' | t | escape }}"
              data-label-unfavorite-text="{{ 'product.favorited_button' | t | escape }}"
              aria-label="{{ 'product.favorite_add' | t: title: product.title | escape }}"
              aria-pressed="false"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.8c0 5.1-8.8 11-8.8 11s-8.8-5.9-8.8-11A4.8 4.8 0 0 1 12 6.1a4.8 4.8 0 0 1 8.8 2.7Z"></path></svg>
              <span data-favorite-label>{{ 'product.favorite_button' | t }}</span>
            </button>
          </div>
          <div class="main-product__social-proof" data-product-social-proof>
            <div class="main-product__social-proof-row">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="10" cy="7" r="4"></circle><path d="M20 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              <p><strong><span data-social-viewers></span> {{ 'product.social_people' | t }}</strong> {{ 'product.social_viewing_now' | t }}</p>
            </div>
            <div class="main-product__social-proof-row">
              <svg class="main-product__social-proof-sales-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m13 2-3 8H5l6 12 3-8h5L13 2Z"></path></svg>
              <p><strong><span data-social-sold></span> {{ 'product.social_sold' | t }}</strong> {{ 'product.social_sold_24h' | t }}</p>
            </div>
            <div class="main-product__social-proof-row" data-product-stock role="status" aria-live="polite" hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 7 5 5 4-4 8 8"></path><path d="M14 16h6v-6"></path></svg>
              <p data-stock-low hidden>{{ 'product.stock_remaining' | t }} <strong data-stock-quantity></strong> {{ 'product.stock_units' | t }} {{ 'product.stock_this_option' | t }}</p>
              <p data-stock-out hidden>{{ 'product.stock_sold_out' | t }}</p>
            </div>
          </div>
          <div class="main-product__trust" aria-label="{{ 'product.purchase_benefits' | t | escape }}">
            <div class="main-product__trust-item">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M1 3h15v13H1z"></path><path d="M16 8h4l3 3v5h-7z"></path><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
              <p>{{ 'product.free_shipping_over' | t }}</p>
            </div>
            <div class="main-product__trust-item">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5"></path><path d="M4 17v-5h5"></path><path d="M5.6 9a7 7 0 0 1 11.6-2L20 12"></path><path d="M18.4 15a7 7 0 0 1-11.6 2L4 12"></path></svg>
              <p>{{ 'product.returns_30_days' | t }}</p>
            </div>
            <div class="main-product__trust-item">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"></path></svg>
              <p>{{ 'product.secure_purchase' | t }}</p>
            </div>
          </div>
        {% endform %}

        <div class="main-product__accordions">
          <details class="main-product__accordion">
            <summary>{{ 'product.description' | t }} <span aria-hidden="true">+</span></summary>
            <div class="main-product__accordion-content rte">
              {% if product.description != blank %}{{ product.description }}{% else %}<p>{{ 'product.not_informed' | t }}</p>{% endif %}
            </div>
          </details>
          <details class="main-product__accordion">
            <summary>{{ 'product.composition' | t }} <span aria-hidden="true">+</span></summary>
            <div class="main-product__accordion-content">
              {% if composition != blank %}{{ composition_field | metafield_tag }}{% else %}<p>{{ 'product.not_informed' | t }}</p>{% endif %}
            </div>
          </details>
          <details class="main-product__accordion">
            <summary>{{ 'product.technology' | t }} <span aria-hidden="true">+</span></summary>
            <div class="main-product__accordion-content">
              {% if technologies != blank %}
                <ul class="main-product__technology-list">
                  {% for technology in technologies %}
                    {% assign technology_label = technology.descricao_1.value | default: 'product.technology' | t %}
                    {% assign technology_icon = technology.icone_1.value %}
                    <li>
                      {% if technology_icon != blank %}{{ technology_icon | image_url: width: 96 | image_tag: width: 40, height: 40, loading: 'lazy', alt: '' }}{% endif %}
                      <span>{{ technology_label | escape }}</span>
                    </li>
                  {% endfor %}
                </ul>
              {% else %}<p>{{ 'product.no_technologies' | t }}</p>{% endif %}
            </div>
          </details>
        </div>

        {% for block in section.blocks %}
          {% if block.type == '@app' %}
            <div class="main-product__app-block" {{ block.shopify_attributes }}>{% render block %}</div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <dialog class="main-product__dialog" data-size-chart-dialog aria-labelledby="ProductSizeChartTitle-{{ section.id }}">
    <div class="main-product__dialog-panel">
      <div class="main-product__dialog-heading">
        <h2 id="ProductSizeChartTitle-{{ section.id }}">{{ 'product.size_chart_title' | t }}</h2>
        <button type="button" data-dialog-close aria-label="{{ 'product.close_size_chart' | t | escape }}">×</button>
      </div>
      {% if chart_kind == 'bottoms' %}
        {% assign chart_alt = 'product.size_chart_bottoms_alt' | t %}
        <img src="{{ 'product-size-chart-bottom.webp' | asset_url }}" alt="{{ chart_alt | escape }}" width="1254" height="1254" loading="lazy" decoding="async">
      {% else %}
        {% assign chart_alt = 'product.size_chart_tops_alt' | t %}
        <img src="{{ 'product-size-chart-top.webp' | asset_url }}" alt="{{ chart_alt | escape }}" width="1254" height="1254" loading="lazy" decoding="async">
      {% endif %}
    </div>
  </dialog>

  <dialog class="main-product__lightbox" data-product-lightbox aria-label="{{ 'product.enlarged_image' | t | escape }}">
    <button class="main-product__lightbox-close" type="button" data-lightbox-close aria-label="{{ 'product.close_enlarged_image' | t | escape }}">×</button>
    <div data-lightbox-content></div>
  </dialog>

  <div class="main-product__sticky" data-sticky-product hidden>
    <div class="main-product__sticky-product">
      {% if product.featured_image %}{{ product.featured_image | image_url: width: 120 | image_tag: width: 60, height: 75, loading: 'lazy', alt: '' }}{% endif %}
      <div><span>{{ product.title | escape }}</span><strong data-sticky-price>{{ selected_variant.price | money }}</strong></div>
    </div>
    <button type="button" data-sticky-add>{{ 'product.add_to_cart' | t }}</button>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_product",
  "tag": "section",
  "class": "shopify-section-main-product",
  "settings": [
    {
      "type": "select",
      "id": "size_chart",
      "label": "t:sections.product_size_chart",
      "options": [
        { "value": "auto", "label": "t:sections.product_size_chart_auto" },
        { "value": "tops", "label": "t:sections.product_size_chart_tops" },
        { "value": "bottoms", "label": "t:sections.product_size_chart_bottoms" }
      ],
      "default": "auto"
    }
  ],
  "blocks": [
    { "type": "@app" }
  ]
}
