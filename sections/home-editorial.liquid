{% liquid
  assign editorial = metaobjects.editorialcollectionsection.editorialcollection
  assign image = section.settings.image | default: editorial.image.value
  assign fallback_image = metaobjects.bannerherohome.bannerhero.image_1.value
  if image == blank
    assign image = fallback_image
  endif

  assign image_alt = image.alt | default: 'Sobre a Upy'
  assign eyebrow = section.settings.eyebrow | default: editorial.etiqueta.value | default: 'Sobre a Upy'
  assign title = section.settings.title | default: editorial.titulo.value | default: 'Você. Da forma que quiser.'
  assign description = section.settings.description | default: editorial.descricao.value | default: 'Conheça a essência, o movimento e as escolhas por trás da nova UPY.'
  assign manifesto_page = pages['manifesto']
  assign default_link = manifesto_page.url | default: '/pages/manifesto'
  assign editorial_link = section.settings.link | default: default_link
%}

<section class="home-editorial">
  <a class="home-editorial__visual" href="{{ editorial_link }}" aria-label="Abrir o Manifesto da UPY">
    {% if image != blank %}
      <img
        class="home-editorial__image"
        src="{{ image | image_url: width: 2000 }}"
        srcset="
          {{ image | image_url: width: 480 }} 480w,
          {{ image | image_url: width: 750 }} 750w,
          {{ image | image_url: width: 1000 }} 1000w,
          {{ image | image_url: width: 1400 }} 1400w,
          {{ image | image_url: width: 1800 }} 1800w,
          {{ image | image_url: width: 2000 }} 2000w
        "
        sizes="(min-width: 1024px) 64vw, 100vw"
        width="{{ image.width | default: 2000 }}"
        height="{{ image.height | default: 1200 }}"
        alt="{{ image_alt | escape }}"
        loading="lazy"
        decoding="async"
      >
    {% endif %}
    <span class="home-editorial__mobile-link">Nosso manifesto</span>
  </a>

  <div class="home-editorial__content">
    <div class="home-editorial__copy">
      {% if eyebrow != blank %}<p class="home-editorial__eyebrow">{{ eyebrow | escape }}</p>{% endif %}
      {% if title != blank %}<h2 class="home-editorial__title">{{ title | escape }}</h2>{% endif %}
      {% if description != blank %}<p class="home-editorial__description">{{ description | escape }}</p>{% endif %}
    </div>
  </div>
</section>


{% stylesheet %}
.home-editorial {
  display: grid;
  overflow: hidden;
  border-top: 1px solid var(--upy-line);
  padding-top: 1.25rem;
  background: var(--upy-canvas);
  color: var(--upy-ink);
}

.home-editorial__visual {
  position: relative;
  display: block;
  min-height: 23.75rem;
  overflow: hidden;
  color: var(--upy-ink);
  outline: none;
}

.home-editorial__visual:focus-visible {
  outline: 2px solid var(--upy-accent);
  outline-offset: -4px;
}

.home-editorial__image {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 700ms ease-out;
}

.home-editorial__mobile-link {
  position: absolute;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%);
  color: var(--upy-ink);
  font-family: var(--upy-font-heading);
  font-size: 0.875rem;
  font-weight: 500;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.25rem;
  white-space: nowrap;
}

.home-editorial__content {
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 3rem 1.25rem;
}

.home-editorial__copy {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 42rem;
  margin-inline: auto;
}

.home-editorial__eyebrow {
  margin: 0;
  color: var(--upy-accent);
  font-family: var(--upy-font-heading);
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  line-height: 1.4;
  text-transform: uppercase;
}

.home-editorial__title {
  max-width: 18ch;
  margin: 1rem 0 0;
  color: var(--upy-ink);
  font-family: var(--upy-font-heading);
  font-size: clamp(2.5rem, 3.2vw, 3.5rem);
  font-weight: 300;
  letter-spacing: -0.045em;
  line-height: 1.08;
  text-wrap: balance;
  overflow-wrap: anywhere;
}

.home-editorial__description {
  max-width: 68ch;
  margin: 1.25rem 0 0;
  color: var(--upy-ink);
  font-size: 1rem;
  line-height: 1.7;
}

@media (min-width: 640px) {
  .home-editorial__visual {
    min-height: 31.25rem;
  }

  .home-editorial__content {
    padding: 4rem 2.5rem;
  }

}

@media (min-width: 1024px) {
  .home-editorial {
    grid-template-columns: minmax(0, 1.28fr) minmax(0, 0.72fr);
    padding-top: 1.25rem;
  }

  .home-editorial__visual {
    min-height: 0;
    align-self: start;
  }

  .home-editorial__image {
    position: relative;
    inset: auto;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .home-editorial__mobile-link {
    display: none;
  }

  .home-editorial__content {
    padding: 3rem clamp(3rem, 4vw, 5rem);
  }

}

@media (hover: hover) and (pointer: fine) {
  .home-editorial__visual:hover .home-editorial__image {
    transform: scale(1.015);
  }

}

@media (prefers-reduced-motion: reduce) {
  .home-editorial__image {
    transition: none;
  }

}
{% endstylesheet %}

{% schema %}
{
  "name": "Sobre a Upy",
  "limit": 1,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto de apoio"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrição"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link do manifesto"
    }
  ],
  "presets": [
    {
      "name": "Sobre a Upy"
    }
  ]
}
{% endschema %}
