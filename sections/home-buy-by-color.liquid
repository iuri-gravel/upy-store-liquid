{% liquid
  assign color_featured = metaobjects.featuredcollectionssection3.featuredcollections3
  assign fallback_image = metaobjects.bannerherohome.bannerhero.image_1.value
%}

<section class="home-buy-color" data-buy-color>
  <div class="home-buy-color__heading-wrap">
    <h2 class="home-buy-color__heading">{{ section.settings.title | default: 'Comprar por cor' | escape }}</h2>
  </div>

  <div class="home-buy-color__grid" data-buy-color-grid>
    {% for color_index in (1..4) %}
      {% liquid
        case color_index
          when 1
            assign color_name = 'Preto'
            assign color_label = 'PRETO'
            assign fallback_color = '#111111'
            assign color_filter_values = 'Preto,Preta,Pretos,Pretas'
          when 2
            assign color_name = 'Azul'
            assign color_label = 'AZUL'
            assign fallback_color = '#2B3F5F'
            assign color_filter_values = 'Azul,Azuis'
          when 3
            assign color_name = 'Vinho'
            assign color_label = 'VINHO'
            assign fallback_color = '#752F43'
            assign color_filter_values = 'Vinho,Vinhos,Bordo,Bordô'
          when 4
            assign color_name = 'Marrom'
            assign color_label = 'MARROM'
            assign fallback_color = '#704E35'
            assign color_filter_values = 'Marrom,Marrons'
        endcase

        assign image_key = 'image_' | append: color_index
        assign color_key = 'cor_' | append: color_index
        assign color_image = color_featured[image_key].value
        if color_image == blank
          assign color_image = fallback_image
        endif
        assign image_alt_fallback = 'Produtos na cor ' | append: color_name
        assign image_alt = color_image.alt | default: image_alt_fallback

        assign swatch_color = color_featured[color_key].value | remove: '"' | strip
        assign swatch_prefix = swatch_color | slice: 0
        if swatch_prefix != '#'
          assign swatch_color = fallback_color
        endif

        assign encoded_filter_values = color_filter_values | url_encode
        assign color_url = routes.all_products_collection_url | append: '?filter.v.option.cor=' | append: encoded_filter_values
      %}

      <article class="home-buy-color__item{% if forloop.first %} is-selected{% endif %}" data-buy-color-item data-color-index="{{ forloop.index0 }}" id="{{ section.id }}-color-{{ color_index }}" {% if forloop.first %}aria-current="true"{% endif %}>
        <a class="home-buy-color__card" href="{{ color_url }}" aria-label="Ver produtos na cor {{ color_name | escape }}">
          {% if color_image != blank %}
            <img
              class="home-buy-color__image"
              src="{{ color_image | image_url: width: 1200 }}"
              srcset="
                {{ color_image | image_url: width: 320 }} 320w,
                {{ color_image | image_url: width: 480 }} 480w,
                {{ color_image | image_url: width: 640 }} 640w,
                {{ color_image | image_url: width: 800 }} 800w,
                {{ color_image | image_url: width: 960 }} 960w,
                {{ color_image | image_url: width: 1200 }} 1200w
              "
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 84vw"
              width="{{ color_image.width | default: 1200 }}"
              height="{{ color_image.height | default: 1500 }}"
              alt="{{ image_alt | escape }}"
              loading="lazy"
              decoding="async"
            >
          {% endif %}
          <span class="home-buy-color__shade" aria-hidden="true"></span>
          <span class="home-buy-color__label">{{ color_label }}</span>
        </a>
      </article>
    {% endfor %}
  </div>

  <div class="home-buy-color__picker">
    <p class="home-buy-color__caption">{{ section.settings.caption | default: 'Encontre o seu tom' | escape }}</p>
    <div class="home-buy-color__swatch-row">
      <span class="home-buy-color__rule" aria-hidden="true"></span>
      <div class="home-buy-color__swatches" role="group" aria-label="Comprar por cor">
        {% for color_index in (1..4) %}
          {% liquid
            case color_index
              when 1
                assign color_name = 'Preto'
                assign fallback_color = '#111111'
                assign color_filter_values = 'Preto,Preta,Pretos,Pretas'
              when 2
                assign color_name = 'Azul'
                assign fallback_color = '#2B3F5F'
                assign color_filter_values = 'Azul,Azuis'
              when 3
                assign color_name = 'Vinho'
                assign fallback_color = '#752F43'
                assign color_filter_values = 'Vinho,Vinhos,Bordo,Bordô'
              when 4
                assign color_name = 'Marrom'
                assign fallback_color = '#704E35'
                assign color_filter_values = 'Marrom,Marrons'
            endcase

            assign color_key = 'cor_' | append: color_index
            assign swatch_color = color_featured[color_key].value | remove: '"' | strip
            assign swatch_prefix = swatch_color | slice: 0
            if swatch_prefix != '#'
              assign swatch_color = fallback_color
            endif

            assign encoded_filter_values = color_filter_values | url_encode
            assign color_url = routes.all_products_collection_url | append: '?filter.v.option.cor=' | append: encoded_filter_values
          %}
          <a
            class="home-buy-color__swatch-link{% if forloop.first %} is-selected{% endif %}"
            href="{{ color_url }}"
            data-buy-color-swatch
            data-color-index="{{ forloop.index0 }}"
            aria-label="Ver produtos na cor {{ color_name | escape }}"
            aria-controls="{{ section.id }}-color-{{ color_index }}"
            title="{{ color_name | escape }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          >
            <span class="home-buy-color__swatch" style="--swatch-color: {{ swatch_color | escape }}" aria-hidden="true"></span>
          </a>
        {% endfor %}
      </div>
      <span class="home-buy-color__rule" aria-hidden="true"></span>
    </div>
  </div>
</section>


{% stylesheet %}
.home-buy-color {
  overflow: hidden;
  padding-top: 0.5rem;
  background: var(--upy-canvas);
  color: var(--upy-ink);
}

.home-buy-color__heading-wrap {
  padding-inline: clamp(1.25rem, 1.6vw, 2rem);
}

.home-buy-color__heading {
  display: table;
  margin: 0;
  border-bottom: 1px solid var(--upy-ink);
  padding-bottom: 0.15rem;
  color: var(--upy-ink);
  font-family: var(--upy-font-heading);
  font-size: clamp(2.5rem, 3vw, 3.5rem);
  font-weight: 300;
  letter-spacing: -0.055em;
  line-height: 1.08;
}

.home-buy-color__grid {
  display: flex;
  gap: 0.25rem;
  margin-top: 2.25rem;
  overflow-x: auto;
  scrollbar-width: none;
  scroll-snap-type: x mandatory;
}

.home-buy-color__grid::-webkit-scrollbar {
  display: none;
}

.home-buy-color__item {
  min-width: 0;
  flex: 0 0 84%;
  scroll-snap-align: start;
}

.home-buy-color__card {
  position: relative;
  display: block;
  overflow: hidden;
  aspect-ratio: 4 / 5;
  background: color-mix(in srgb, var(--upy-ink) 16%, var(--upy-canvas));
  outline: none;
}

.home-buy-color__card:focus-visible {
  outline: 2px solid var(--upy-accent);
  outline-offset: -3px;
}

.home-buy-color__image {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 700ms ease-out;
}

.home-buy-color__card:hover .home-buy-color__image {
  transform: scale(1.025);
}

.home-buy-color__shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgb(0 0 0 / 55%), rgb(0 0 0 / 5%) 48%, transparent 75%);
}

.home-buy-color__label {
  position: absolute;
  inset-inline: 1.125rem;
  bottom: 1.125rem;
  color: #fff;
  font-family: var(--upy-font-heading);
  font-size: 0.9rem;
  font-weight: 600;
  line-height: 1.35;
  text-shadow: 0 1px 5px rgb(0 0 0 / 18%);
}

.home-buy-color__picker {
  border-bottom: 1px solid var(--upy-line);
  padding: 1.5rem 1.25rem 2.5rem;
  text-align: center;
}

.home-buy-color__caption {
  margin: 0 0 1.125rem;
  color: var(--upy-ink);
  font-family: var(--upy-font-heading);
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  line-height: 1.4;
  text-transform: uppercase;
}

.home-buy-color__swatch-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  width: min(100%, 60rem);
  margin-inline: auto;
}

.home-buy-color__rule {
  height: 1px;
  min-width: 1.5rem;
  flex: 1 1 auto;
  background: var(--upy-ink);
}

.home-buy-color__swatches {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 0.9rem;
}

.home-buy-color__swatch-link {
  display: grid;
  width: 2.5rem;
  height: 2.5rem;
  place-items: center;
  border-radius: 50%;
  outline: none;
}

.home-buy-color__swatch-link:focus-visible {
  outline: 2px solid var(--upy-accent);
  outline-offset: 4px;
}

.home-buy-color__swatch {
  display: block;
  width: 2.25rem;
  height: 2.25rem;
  transform: scale(1);
  border: 2px solid #fff;
  border-radius: 50%;
  background: var(--swatch-color, #111);
  box-shadow: 0 2px 6px rgb(28 25 26 / 14%);
  transition: transform 480ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 480ms cubic-bezier(0.22, 1, 0.36, 1);
}

@media (min-width: 640px) {
  .home-buy-color__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
    overflow: visible;
  }

  .home-buy-color__item {
    flex: initial;
  }

  .home-buy-color__picker {
    padding: 1.75rem 2rem 3rem;
  }

  .home-buy-color__swatch-row {
    gap: 1.5rem;
  }

  .home-buy-color__swatches {
    gap: 1.75rem;
  }

  .home-buy-color__swatch-link {
    width: 2.5rem;
    height: 2.5rem;
  }

}

@media (min-width: 1024px) {
  .home-buy-color__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.45rem;
    margin-top: 2.25rem;
  }

  .home-buy-color__item {
    transition: opacity 480ms cubic-bezier(0.22, 1, 0.36, 1), transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-buy-color__swatches {
    gap: 2rem;
  }

}

@media (max-width: 639px) {
  .home-buy-color__heading {
    font-size: clamp(2.25rem, 10vw, 2.8rem);
  }

  .home-buy-color__grid {
    margin-top: 1.5rem;
  }

  .home-buy-color__picker {
    padding-block: 1.25rem 2rem;
  }

}

@media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
  .home-buy-color__item {
    opacity: 0.76;
    transform: scale(0.985);
  }

  .home-buy-color__item.is-selected,
  .home-buy-color__item:hover {
    opacity: 1;
    transform: scale(1);
  }

  .home-buy-color__swatch-link.is-selected .home-buy-color__swatch {
    transform: scale(1.1);
    box-shadow: 0 0 0 3px var(--upy-ink), 0 3px 14px rgb(28 25 26 / 28%);
  }

}

@media (prefers-reduced-motion: reduce) {
  .home-buy-color__item,
  .home-buy-color__image,
  .home-buy-color__swatch {
    transition: none;
  }

}
{% endstylesheet %}

{% schema %}
{
  "name": "Comprar por cor",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Comprar por cor"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Texto dos tons",
      "default": "Encontre o seu tom"
    }
  ],
  "presets": [
    {
      "name": "Comprar por cor"
    }
  ]
}
{% endschema %}
