<section
  class="product-recommendations"
  data-product-recommendations
  data-product-id="{{ product.id }}"
  data-limit="{{ section.settings.product_limit }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&amp;product_id={{ product.id }}&amp;limit={{ section.settings.product_limit }}&amp;intent=complementary"
  aria-labelledby="ProductRecommendationsTitle-{{ section.id }}"
  hidden
>
  {% if recommendations.performed and recommendations.products_count > 0 %}
    <div class="product-recommendations__inner">
      <div class="product-recommendations__heading">
        <h2 id="ProductRecommendationsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      <div class="product-recommendations__grid">
        {% for recommended_product in recommendations.products limit: section.settings.product_limit %}
          <a class="product-recommendations__card" href="{{ recommended_product.url }}">
            {% if recommended_product.featured_image %}
              {{ recommended_product.featured_image | image_url: width: 700 | image_tag: widths: '320, 480, 700', sizes: '(min-width: 1000px) 22vw, 48vw', loading: 'lazy', alt: recommended_product.featured_image.alt | default: recommended_product.title | escape }}
            {% endif %}
            <span>{{ recommended_product.title | escape }}</span>
            <strong>{{ recommended_product.price | money }}</strong>
          </a>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "t:sections.product_recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product_recommendations_heading",
      "default": "Complete o look"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "t:sections.product_recommendations_limit",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
