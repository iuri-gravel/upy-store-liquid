    border: 1px solid #ddd6ce;
    background: #fff;
  }

  .faq-page__item + .faq-page__item {
    border-top: 1px solid #e6e0da;
  }

  .faq-page__item[hidden],
  .faq-page__empty[hidden],
  .faq-page__answer[hidden] {
    display: none !important;
  }

  .faq-page__question {
    display: flex;
    width: 100%;
    min-height: 5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    border: 0;
    padding: 1.25rem;
    background: #fff;
    color: var(--upy-ink);
    cursor: pointer;
    text-align: left;
    transition: background-color 180ms ease;
  }

  .faq-page__question:hover {
    background: #faf9f7;
  }

  .faq-page__question-copy {
    display: grid;
    gap: 0.25rem;
  }

  .faq-page__question-category {
    color: var(--upy-accent);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .faq-page__question-title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .faq-page__chevron {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 1.25rem;
    color: #77716b;
    transition: transform 180ms ease;
  }

  .faq-page__question[aria-expanded="true"] .faq-page__chevron {
    transform: rotate(180deg);
  }

  .faq-page__answer {
    padding: 0 1.25rem 1.5rem;
  }

  .faq-page__answer p {
    max-width: 42rem;
    margin: 0;
    color: #5f5a55;
    font-size: 0.875rem;
    line-height: 1.9;
  }

  .faq-page__empty {
    padding: 3.5rem 1.25rem;
    text-align: center;
  }

  .faq-page__empty svg {
    width: 2rem;
    height: 2rem;
    color: var(--upy-accent);
  }

  .faq-page__empty h2 {
    margin: 1rem 0 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .faq-page__empty p {
    margin: 0.5rem 0 0;
    color: #77716b;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .faq-page__contact {
    margin-top: 2.5rem;
    border: 1px solid #ddd6ce;
    padding: 2rem 1.5rem;
    background: #f7f3ef;
    text-align: center;
  }

  .faq-page__contact-eyebrow {
    margin: 0;
    color: var(--upy-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .faq-page__contact h2 {
    margin: 0.75rem 0 0;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 500;
  }

  .faq-page__contact-hours {
    margin: 0.75rem auto 0;
    color: #5f5a55;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .faq-page__contact-button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    margin-top: 1.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--upy-ink);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .faq-page__contact-button:hover {
    background: #393334;
  }

  .main-page {
    min-height: 40vh;
    background: var(--upy-canvas);
    color: var(--upy-ink);
  }

  .main-page__inner {
    width: min(100% - 2rem, 80rem);
    margin-inline: auto;
    padding-block: clamp(3rem, 8vw, 7rem);
  }

  .main-page__inner h1 {
    margin: 0 0 2rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.04em;
  }

  .main-page__content {
    max-width: 48rem;
    color: #5f5a55;
    line-height: 1.9;
  }

  .main-page__content p {
    margin: 0 0 1.25rem;
  }

  @media (min-width: 640px) {
    .manifesto__hero-inner,
    .manifesto__content {
      width: min(100% - 3rem, 1440px);
    }

    .shipping-page__hero-inner,
    .shipping-page__container {
      width: min(100% - 3rem, 1440px);
    }

    .shipping-page__hero-inner {
      padding-block: 4rem;
    }

    .shipping-page__container {
      padding-block: 3.5rem;
    }

    .shipping-page__panel {
      padding-inline: 2rem;
    }

    .shipping-page__summary {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .shipping-page__card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .shipping-page__card-grid--single {
      grid-template-columns: minmax(0, 1fr);
    }

    .faq-page__hero-inner {
      padding-block: 4rem;
    }

    .faq-page__content {
      padding-block: 3.5rem 5rem;
    }

    .faq-page__question {
      padding-inline: 1.75rem;
    }

    .faq-page__answer {
      padding-inline: 1.75rem;
    }

    .faq-page__contact {
      padding: 2.5rem;
    }

    .returns-page__form-panel {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: 3.5rem;
      padding: 2.5rem;
    }

    .returns-page__form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .returns-page__submit {
      width: fit-content;
    }

    .shipping-page__actions {
      flex-direction: row;
    }

    .manifesto__hero-inner {
      padding-block: 4rem;
    }

    .manifesto__content {
      padding-block: 3.5rem;
    }

    .manifesto__story {
      padding-top: 4rem;
    }

    .manifesto__copy {
      font-size: 1.05rem;
    }
  }

  @media (min-width: 1024px) {
    .manifesto__hero-inner,
    .manifesto__content {
      width: min(100% - 4rem, 1440px);
    }

    .shipping-page__hero-inner,
    .shipping-page__container {
      width: min(100% - 4rem, 1440px);
    }

    .shipping-page__hero-inner {
      padding-block: 6rem;
    }

    .shipping-page__container {
      padding-block: 4rem;
