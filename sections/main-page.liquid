    }
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto__poster,
    .manifesto__play {
      transition-duration: 0.01ms;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', function (event) {
    var button = event.target.closest('[data-manifesto-play]');
    if (!button) return;

    var videoId = button.dataset.videoId || '';
    if (!/^[\w-]{11}$/.test(videoId)) return;

    var container = button.closest('[data-manifesto-video]');
    var frame = container.querySelector('[data-manifesto-frame]');
    var overlay = container.querySelector('[data-manifesto-overlay]');
    var iframe = document.createElement('iframe');

    iframe.src = 'https://www.youtube-nocookie.com/embed/' + videoId + '?autoplay=1&rel=0';
    iframe.title = button.dataset.videoTitle || 'UPY Manifesto video';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.loading = 'eager';

    frame.replaceChildren(iframe);
    frame.hidden = false;
    overlay.hidden = true;
  });

  function updateFaqResults(container) {
    var search = container.querySelector('[data-faq-search]');
    var activeCategory = container.querySelector('[data-faq-category][aria-pressed="true"]');
    var query = search ? search.value.trim().toLocaleLowerCase() : '';
    var category = activeCategory ? activeCategory.dataset.faqCategory : 'all';
    var visibleCount = 0;

    container.querySelectorAll('[data-faq-item]').forEach(function (item) {
      var matchesCategory = category === 'all' || item.dataset.faqItemCategory === category;
      var matchesSearch = !query || item.textContent.toLocaleLowerCase().includes(query);
      var visible = matchesCategory && matchesSearch;
      item.hidden = !visible;
      if (visible) visibleCount += 1;
    });

    var emptyState = container.querySelector('[data-faq-empty]');
    if (emptyState) emptyState.hidden = visibleCount > 0;
  }

  document.addEventListener('input', function (event) {
    var search = event.target.closest('[data-faq-search]');
    if (search) updateFaqResults(search.closest('[data-faq-root]'));
  });

  document.addEventListener('click', function (event) {
    var categoryButton = event.target.closest('[data-faq-category]');
    if (categoryButton) {
      var categoryRoot = categoryButton.closest('[data-faq-root]');
      categoryRoot.querySelectorAll('[data-faq-category]').forEach(function (button) {
        button.setAttribute('aria-pressed', button === categoryButton ? 'true' : 'false');
      });
      updateFaqResults(categoryRoot);
      return;
    }

    var questionButton = event.target.closest('[data-faq-question]');
    if (!questionButton) return;

    var questionRoot = questionButton.closest('[data-faq-root]');
    var wasExpanded = questionButton.getAttribute('aria-expanded') === 'true';
    questionRoot.querySelectorAll('[data-faq-question]').forEach(function (button) {
      var expanded = button === questionButton && !wasExpanded;
      button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      var answer = questionRoot.querySelector('#' + button.getAttribute('aria-controls'));
      if (answer) answer.hidden = !expanded;
    });
  });

  document.addEventListener('input', function (event) {
    var input = event.target.closest('[data-returns-phone]');
    if (!input) return;

    var digits = input.value.replace(/\D/g, '').slice(0, 11);
    if (digits.length <= 2) {
      input.value = digits;
    } else if (digits.length <= 6) {
      input.value = '(' + digits.slice(0, 2) + ') ' + digits.slice(2);
    } else if (digits.length <= 10) {
      input.value = '(' + digits.slice(0, 2) + ') ' + digits.slice(2, 6) + '-' + digits.slice(6);
    } else {
      input.value = '(' + digits.slice(0, 2) + ') ' + digits.slice(2, 7) + '-' + digits.slice(7);
    }
  });

  document.addEventListener('submit', function (event) {
    var form = event.target.closest('#ReturnsSupportForm');
    if (!form) return;

    var button = form.querySelector('[data-returns-submit]');
    var label = button && button.querySelector('span');
    if (!button || !label) return;

    button.disabled = true;
    label.textContent = button.dataset.submittingLabel || label.textContent;
  });

  var returnsSuccess = document.querySelector('[data-returns-success]');
  if (returnsSuccess) returnsSuccess.focus({ preventScroll: true });
{% endjavascript %}

