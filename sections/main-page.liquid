{% if page.handle == 'manifesto' %}
  {% render 'manifesto-page', section: section %}
{% elsif page.handle == 'frete-e-entregas' %}
  {% render 'shipping-page' %}
{% elsif page.handle == 'trocas-e-devolucoes' %}
  {% render 'returns-page' %}
{% elsif page.handle == 'faq' %}
  {% render 'faq-page' %}
{% elsif page.handle == 'politica-de-privacidade' or page.handle == 'politica-de-cookies' or page.handle == 'termos-de-uso' %}
  {% render 'legal-policy-page' %}
{% elsif page.handle == 'cadastro' %}
  {% render 'register-page', section: section %}
{% else %}
  <section class="main-page">
    <div class="main-page__inner">
      <h1>{{ page.title | escape }}</h1>
      <div class="main-page__content rte">{{ page.content }}</div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
.main-page {
    min-height: 40vh;
    background: var(--upy-canvas);
    color: var(--upy-ink);
  }

  .main-page__inner {
    width: min(100% - 2rem, 80rem);
    margin-inline: auto;
    padding-block: clamp(3rem, 8vw, 7rem);
  }

  .main-page__inner h1 {
    margin: 0 0 2rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.04em;
  }

  .main-page__content {
    max-width: 48rem;
    color: #5f5a55;
    line-height: 1.9;
  }

  .main-page__content p {
    margin: 0 0 1.25rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_page",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "t:sections.manifesto_video_url",
      "default": "https://www.youtube.com/shorts/owXwxEkc5PU"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "t:sections.manifesto_video_poster"
    },
    {
      "type": "text",
      "id": "register_eyebrow",
      "label": "t:sections.register_eyebrow",
      "default": "CONTA UPY"
    },
    {
      "type": "text",
      "id": "register_title",
      "label": "t:sections.register_title",
      "default": "Crie sua conta Upy"
    },
    {
      "type": "textarea",
      "id": "register_description",
      "label": "t:sections.register_description",
      "default": "Acompanhe seus pedidos e tenha uma experiência mais prática na loja."
    },
    {
      "type": "text",
      "id": "register_card_eyebrow",
      "label": "t:sections.register_card_eyebrow",
      "default": "CADASTRO SEGURO NA SHOPIFY"
    },
    {
      "type": "text",
      "id": "register_card_title",
      "label": "t:sections.register_card_title",
      "default": "Crie ou acesse sua conta"
    },
    {
      "type": "textarea",
      "id": "register_card_description",
      "label": "t:sections.register_card_description",
      "default": "Continue para a área de contas da Shopify para criar ou acessar seu cadastro da Upy."
    },
    {
      "type": "text",
      "id": "register_button_label",
      "label": "t:sections.register_button_label",
      "default": "CONTINUAR PARA A SHOPIFY"
    },
    {
      "type": "textarea",
      "id": "register_privacy_note",
      "label": "t:sections.register_privacy_note",
      "default": "O cadastro é concluído diretamente pela Shopify, que vincula as informações à sua conta na loja."
    },
    {
      "type": "text",
      "id": "register_login_prompt",
      "label": "t:sections.register_login_prompt",
      "default": "Já tem uma conta?"
    },
    {
      "type": "text",
      "id": "register_login_link",
      "label": "t:sections.register_login_link",
      "default": "Entrar"
    }
  ]
}
{% endschema %}
