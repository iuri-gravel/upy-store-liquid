{% liquid
  assign hero = metaobjects.bannerherohome.bannerhero
  assign image_1 = hero.image_1.value
  assign image_2 = hero.image_2.value
  assign mobile_image_1 = hero.imagem_m1.value
  assign mobile_image_2 = hero.imagem_m2.value
  assign collection_1 = hero.colecao_1.value
  assign collection_2 = hero.colecao_2.value
  assign hero_label = hero.etiqueta.value
  assign hero_title = hero.titulo.value
  assign hero_description = hero.descricao.value
  assign hero_slide_count = 0
  if image_1 != blank
    assign hero_slide_count = hero_slide_count | plus: 1
  endif
  if image_2 != blank
    assign hero_slide_count = hero_slide_count | plus: 1
  endif
%}

<section class="home-hero" data-home-hero data-interval="5000" aria-label="{{ 'home.hero.label' | t }}" {% if hero_slide_count == 0 %}aria-busy="true"{% endif %}>
  <div class="home-hero__track" data-home-hero-track>
    {% if image_1 != blank %}
      {% render 'home-hero-slide', image: image_1, mobile_image: mobile_image_1, collection: collection_1, index: 1, total: hero_slide_count, eager: true %}
    {% endif %}
    {% if image_2 != blank %}
      {% render 'home-hero-slide', image: image_2, mobile_image: mobile_image_2, collection: collection_2, index: 2, total: hero_slide_count, eager: false %}
    {% endif %}
  </div>

  {% if hero_label != blank or hero_title != blank or hero_description != blank %}
    <div class="home-hero__copy">
      <div class="home-hero__copy-inner">
        {% if hero_label != blank %}<p class="upy-section-label">{{ hero_label | escape }}</p>{% endif %}
        {% if hero_title != blank %}<h1 class="upy-display-title">{{ hero_title | escape }}</h1>{% endif %}
        {% if hero_description != blank %}<p class="upy-body-copy">{{ hero_description | escape }}</p>{% endif %}
      </div>
    </div>
  {% endif %}

  {% if hero_slide_count > 1 %}
    <div class="home-hero__controls">
      <button class="home-hero__arrow home-hero__arrow--previous" type="button" data-home-hero-previous aria-label="{{ 'home.hero.previous' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      </button>
      <div class="home-hero__dots" aria-label="{{ 'home.hero.choose_slide' | t }}">
        {% for slide_number in (1..hero_slide_count) %}
          <button class="home-hero__dot{% if forloop.first %} is-active{% endif %}" type="button" data-home-hero-dot="{{ forloop.index0 }}" aria-label="{{ 'home.hero.go_to_slide' | t: number: forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %}></button>
        {% endfor %}
      </div>
      <button class="home-hero__arrow home-hero__arrow--next" type="button" data-home-hero-next aria-label="{{ 'home.hero.next' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
      </button>
    </div>
    <p class="visually-hidden" data-home-hero-status aria-live="polite"></p>
  {% endif %}
</section>


{% stylesheet %}
.home-hero {
  position: relative;
  width: 100%;
  aspect-ratio: 27 / 40;
  overflow: hidden;
  background: #e5e1dd;
  color: #fff;
}

.home-hero__track {
  position: absolute;
  inset: 0;
  display: flex;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  overscroll-behavior-x: contain;
}

.home-hero__track::-webkit-scrollbar {
  display: none;
}

.home-hero__slide {
  position: relative;
  flex: 0 0 100%;
  min-width: 0;
  scroll-snap-align: start;
}

.home-hero__picture,
.home-hero__image {
  display: block;
  width: 100%;
  height: 100%;
}

.home-hero__image {
  object-fit: cover;
}

.home-hero::after {
  position: absolute;
  z-index: 1;
  inset: 0;
  background: linear-gradient(0deg, rgb(0 0 0 / 65%), rgb(0 0 0 / 20%) 55%, rgb(0 0 0 / 15%));
  content: "";
  pointer-events: none;
}

.home-hero__copy {
  position: absolute;
  z-index: 2;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 4rem 1rem;
  pointer-events: none;
  text-align: center;
}

.home-hero__copy-inner {
  width: min(100%, 48rem);
}

.home-hero__copy .upy-section-label {
  color: #f4e1c6;
}

.home-hero__copy .upy-display-title {
  margin: 1rem auto 0;
}

.home-hero__copy .upy-body-copy {
  max-width: 36rem;
  margin: 1.5rem auto 0;
  color: rgb(255 255 255 / 90%);
}

.home-hero__controls {
  position: absolute;
  z-index: 4;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 0.75rem;
  padding: 0 1rem 1.5rem;
  pointer-events: none;
}

.home-hero__arrow {
  position: absolute;
  top: 50%;
  display: inline-flex;
  width: 3rem;
  min-width: 3rem;
  height: 3rem;
  min-height: 3rem;
  align-items: center;
  justify-content: center;
  transform: translateY(-50%);
  border: 0;
  border-radius: 50%;
  background: rgb(28 25 26 / 42%);
  backdrop-filter: blur(4px);
  color: #fff;
  cursor: pointer;
  pointer-events: auto;
  transition: background-color 180ms ease, transform 180ms ease;
}

.home-hero__arrow:hover {
  transform: translateY(-50%) scale(1.06);
  background: rgb(28 25 26 / 62%);
}

.home-hero__arrow:focus-visible {
  outline: 2px solid #fff;
  outline-offset: 3px;
}

.home-hero__arrow--previous {
  left: clamp(1rem, 2.5vw, 2rem);
}

.home-hero__arrow--next {
  right: clamp(1rem, 2.5vw, 2rem);
}

.home-hero__arrow svg {
  width: 1.35rem;
  height: 1.35rem;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.7;
}

.home-hero__dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  pointer-events: auto;
}

.home-hero__dot {
  width: 0.65rem;
  height: 0.65rem;
  border: 1px solid rgb(255 255 255 / 85%);
  border-radius: 999px;
  padding: 0;
  background: rgb(255 255 255 / 30%);
  cursor: pointer;
  transition: width 220ms ease, background-color 220ms ease;
}

.home-hero__dot.is-active {
  width: 2rem;
  background: #fff;
}

@media (min-width: 768px) {
  .home-hero {
    aspect-ratio: 16 / 9;
  }

  .home-hero__controls {
    padding-bottom: 2rem;
  }

}

@media (max-width: 479px) {

  .home-hero__arrow {
    width: 2.75rem;
    min-width: 2.75rem;
    height: 2.75rem;
    min-height: 2.75rem;
  }

}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.home_hero",
  "limit": 1,
  "presets": [
    {
      "name": "t:sections.home_hero"
    }
  ]
}
{% endschema %}
