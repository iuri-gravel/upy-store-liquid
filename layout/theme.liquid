<!doctype html>
<html lang="{{ localization.language.iso_code | default: 'pt-BR' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_canvas }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    <title>{{ page_title | escape }}{% unless page_title contains shop.name %} · {{ shop.name | escape }}{% endunless %}</title>
    {% if page_description != blank %}
      <meta name="description" content="{{ page_description | strip_html | escape }}">
    {% elsif shop.description != blank %}
      <meta name="description" content="{{ shop.description | strip_html | escape }}">
    {% endif %}
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
    {% if request.page_type == 'product' and product != blank %}
      <script type="application/ld+json">
        {{ product | structured_data }}
      </script>
    {% endif %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {% if request.page_type == 'product' %}
      {{ 'product-page.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'product-page.js' | asset_url }}" defer></script>
    {% endif %}
    <style>
      :root {
        --upy-canvas: {{ settings.color_canvas }};
        --upy-ink: {{ settings.color_ink }};
        --upy-accent: {{ settings.color_accent }};
        --upy-footer: {{ settings.color_footer }};
        --upy-footer-text: {{ settings.color_footer_text }};
      }
    </style>
    <script src="{{ 'theme.js' | asset_url }}" data-home-script="{{ 'home.js' | asset_url }}" data-cards-script="{{ 'product-cards.js' | asset_url }}" data-recent-script="{{ 'recently-viewed.js' | asset_url }}" defer></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
    <script src="{{ 'footer.js' | asset_url }}" defer></script>
    {{ content_for_header }}
    <script defer id="sizebay-vfr-v4" src="https://static.sizebay.technology/8192/prescript.js"></script>
  </head>
  <body
    {% if request.page_type == 'product' and product != blank %}
      data-recent-product-id="{{ product.id }}"
      data-recent-product-handle="{{ product.handle | escape }}"
    {% endif %}
  >
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    <a
      class="site-whatsapp"
      href="https://wa.me/5522999411413?text={{ 'Olá! Vim do site da Upy Store e gostaria de tirar uma dúvida.' | url_encode }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="{{ 'accessibility.whatsapp_contact' | t | escape }}"
      title="{{ 'accessibility.whatsapp_contact' | t | escape }}"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.768.966-.941 1.164-.173.198-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.654-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479s1.065 2.875 1.213 3.074c.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.999-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.266c.002-5.45 4.437-9.884 9.888-9.884 2.64 0 5.122 1.03 6.987 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.438 9.89-9.885 9.89m8.413-18.3A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.946L.057 24l6.335-1.662a11.88 11.88 0 0 0 5.655 1.441h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.48-8.4z" />
      </svg>
    </a>
  </body>
</html>
